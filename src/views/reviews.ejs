<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <meta name="description" content="Customer Review Assistant for <%= shopName %>">

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>

    <!-- Axios -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: "#f5f3ff",
                            100: "#ede9fe",
                            500: "<%= themeColor %>",
                            600: "#4f46e5",
                            700: "#4338ca",
                        }
                    }
                }
            }
        };
    </script>

    <style>
        [x-cloak] { display: none !important; }
        body {
            background: radial-gradient(circle at 50% -10%, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
            -webkit-tap-highlight-color: transparent;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(226, 232, 240, 0.9);
        }
        .glow-button {
            box-shadow: 0 12px 28px -6px rgba(79, 70, 229, 0.4);
        }
        .ig-gradient {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        }
        .ig-glow {
            box-shadow: 0 10px 24px -5px rgba(225, 48, 108, 0.35);
        }
        .star-glow {
            filter: drop-shadow(0 2px 8px rgba(251, 191, 36, 0.5));
        }
        /* Mobile ergonomic touch target */
        .touch-target {
            min-height: 48px;
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-900 flex flex-col justify-between py-5 px-3 sm:px-6">

    <div class="max-w-md w-full mx-auto my-auto space-y-4" x-data="reviewPageData()" x-cloak>

        <% if (!isAuthorized) { %>
        <!-- Lock Screen / Passcode Entry -->
        <div class="glass-card rounded-[32px] p-7 sm:p-9 shadow-2xl border border-slate-200/90 text-center animate__animated animate__fadeInUp">
            <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-3xl mx-auto flex items-center justify-center text-2xl mb-5 shadow-sm">
                <i class="fas fa-lock"></i>
            </div>

            <h2 class="text-2xl font-black text-slate-900 mb-1.5">Access Protected</h2>
            <p class="text-xs sm:text-sm text-slate-500 mb-6">Enter the review generator access passcode to continue.</p>

            <form @submit.prevent="submitKey()" class="space-y-4">
                <div class="relative">
                    <input type="password" x-model="keyInput" placeholder="Enter access passcode..."
                        class="touch-target w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-center font-mono text-sm focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white outline-none transition-all"
                        required autofocus>
                </div>

                <% if (providedKey) { %>
                <div class="p-3 bg-rose-50 border border-rose-100 rounded-2xl text-xs text-rose-600 font-medium">
                    Invalid passcode. Please check and try again.
                </div>
                <% } %>

                <button type="submit"
                    class="touch-target w-full py-4 bg-slate-900 text-white rounded-2xl font-bold text-sm hover:bg-slate-800 active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-lg">
                    <span>Unlock Generator</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-slate-100 text-[11px] text-slate-400 font-medium">
                <%= shopName %> &bull; Powered by Astr
            </div>
        </div>

        <% } else { %>

        <!-- Review Generator Main Interface -->
        <div class="glass-card rounded-[32px] p-5 sm:p-8 shadow-2xl border border-slate-200/90 animate__animated animate__fadeIn space-y-6">
            
            <!-- Shop Header & 5-Star Hero -->
            <div class="text-center">
                <% if (logo) { %>
                <img src="<%= logo %>" alt="<%= shopName %>" class="w-14 h-14 object-contain mx-auto mb-3 rounded-2xl shadow-sm">
                <% } else { %>
                <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-2xl mb-3 shadow-inner">
                    <i class="fas fa-store"></i>
                </div>
                <% } %>

                <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight"><%= shopName %></h1>
                
                <!-- 5 Golden Stars Hero Rating -->
                <div class="inline-flex items-center gap-1.5 mt-2.5 px-3.5 py-1.5 bg-amber-50/90 border border-amber-200/70 rounded-full shadow-sm">
                    <div class="flex items-center gap-1 text-amber-400 star-glow">
                        <i class="fas fa-star text-sm"></i>
                        <i class="fas fa-star text-sm"></i>
                        <i class="fas fa-star text-sm"></i>
                        <i class="fas fa-star text-sm"></i>
                        <i class="fas fa-star text-sm"></i>
                    </div>
                    <span class="text-xs font-black text-slate-800 tracking-wide ml-0.5">5.0 Star Experience</span>
                </div>
                <p class="text-xs text-slate-500 mt-2 px-2">Thank you for visiting! Tap below to draft a 5-star review in seconds.</p>
            </div>

            <!-- Mode Selector Tabs (Thumb Friendly) -->
            <div class="grid grid-cols-2 p-1 bg-slate-100/90 rounded-2xl border border-slate-200/60">
                <button type="button" @click="setMode('random')"
                    :class="mode === 'random' ? 'bg-white text-slate-900 shadow-sm font-black' : 'text-slate-500 font-semibold hover:text-slate-800'"
                    class="touch-target py-3 rounded-xl text-xs transition-all flex items-center justify-center gap-2 active:scale-95">
                    <i class="fas fa-bolt text-amber-500"></i>
                    <span>Quick Positive</span>
                </button>
                <button type="button" @click="setMode('custom')"
                    :class="mode === 'custom' ? 'bg-white text-slate-900 shadow-sm font-black' : 'text-slate-500 font-semibold hover:text-slate-800'"
                    class="touch-target py-3 rounded-xl text-xs transition-all flex items-center justify-center gap-2 active:scale-95">
                    <i class="fas fa-pen-nib text-indigo-500"></i>
                    <span>Specific Service</span>
                </button>
            </div>

            <!-- Custom Mode: Interactive Service Chips & Custom Input -->
            <div x-show="mode === 'custom'" x-transition class="space-y-3">
                <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider ml-1">What did we service or provide?</label>
                    <input type="text" x-model="customPrompt"
                        placeholder="e.g., iPhone screen repair, MacBook battery, Custom PC..."
                        @keydown.enter="generateReview()"
                        class="touch-target w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-medium focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white outline-none transition-all">
                </div>

                <!-- Quick Tap Service Chips -->
                <div class="space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider ml-1">Quick Select:</span>
                    <div class="flex flex-wrap gap-1.5">
                        <template x-for="chip in popularServices" :key="chip">
                            <button type="button" @click="selectServiceChip(chip)"
                                :class="customPrompt === chip ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200'"
                                class="px-3 py-1.5 text-[11px] font-semibold rounded-xl border transition-all active:scale-95">
                                <span x-text="chip"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Primary Generate Action Button -->
            <div>
                <button type="button" @click="generateReview()" :disabled="loading"
                    class="touch-target w-full py-4 bg-slate-900 hover:bg-black active:scale-[0.98] text-white rounded-2xl font-bold text-xs tracking-wider uppercase transition-all flex items-center justify-center gap-2.5 shadow-lg disabled:opacity-50">
                    <i :class="loading ? 'fas fa-spinner fa-spin text-indigo-400' : (mode === 'random' ? 'fas fa-wand-magic-sparkles text-amber-400' : 'fas fa-magic text-indigo-400')"></i>
                    <span x-text="loading ? 'Generating 5-Star Draft...' : (generatedReview ? 'Try Another Variation' : 'Draft 5-Star Review')"></span>
                </button>
            </div>

            <!-- Generated Review Card & Action -->
            <div x-show="generatedReview" x-transition class="space-y-4 pt-1">
                <div class="relative bg-slate-50/90 border border-slate-200 rounded-3xl p-4 sm:p-5 shadow-inner">
                    <div class="flex items-center justify-between mb-2.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-xs font-bold text-slate-800">Your Review Draft</span>
                            <span class="text-[10px] text-emerald-700 bg-emerald-100/80 border border-emerald-300/80 px-2 py-0.5 rounded-full font-bold">5.0 ★</span>
                        </div>
                        <span class="text-[10px] text-slate-400 font-medium">Tap text to edit</span>
                    </div>

                    <!-- Editable Textarea -->
                    <textarea x-model="generatedReview" rows="4"
                        class="w-full bg-white border border-slate-200 rounded-2xl p-3.5 text-xs sm:text-sm text-slate-800 leading-relaxed focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 outline-none transition-all resize-none shadow-sm"></textarea>
                </div>

                <!-- Big Primary Button: Copy & Open Google Reviews -->
                <button type="button" @click="copyAndOpenReview()" :disabled="copying"
                    class="touch-target w-full py-4 bg-gradient-to-r from-indigo-600 via-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white rounded-2xl font-bold text-sm tracking-wide transition-all flex items-center justify-center gap-3 glow-button active:scale-[0.98]">
                    <i :class="copied ? 'fas fa-check-circle text-emerald-300 text-base' : 'fas fa-arrow-up-right-from-square text-sm'"></i>
                    <span x-text="copied ? 'Copied! Opening Google Reviews...' : 'Copy Review & Post on Google'"></span>
                </button>

                <!-- Copy Feedback Toast -->
                <div x-show="copied" x-transition class="text-center p-3 bg-emerald-50 border border-emerald-200 rounded-2xl animate__animated animate__fadeIn">
                    <p class="text-xs text-emerald-700 font-bold flex items-center justify-center gap-1.5">
                        <i class="fas fa-clipboard-check text-emerald-600"></i>
                        <span>Copied to clipboard! Just paste into Google.</span>
                    </p>
                </div>
            </div>

            <!-- Direct Google Review Link Fallback -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 font-medium">
                <span>Direct Google Maps Link</span>
                <a href="<%= reviewUrl %>" target="_blank" rel="noopener noreferrer"
                    class="text-indigo-600 hover:text-indigo-800 font-semibold flex items-center gap-1.5 hover:underline py-1">
                    <span>Open Direct</span>
                    <i class="fas fa-external-link-alt text-[10px]"></i>
                </a>
            </div>
        </div>

        <!-- Instagram Follow Banner (if Instagram configured) -->
        <% if (instagramUsername) { %>
        <div class="glass-card rounded-[28px] p-5 shadow-xl border border-slate-200/90 animate__animated animate__fadeInUp">
            <div class="flex items-center justify-between gap-3">
                <a href="<%= instagramUrl %>" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
                    <div class="w-11 h-11 rounded-2xl ig-gradient flex items-center justify-center text-white text-xl ig-glow shrink-0 group-hover:scale-105 transition-transform">
                        <i class="fab fa-instagram"></i>
                    </div>
                    <div>
                        <h4 class="text-xs font-black text-slate-900 group-hover:text-pink-600 transition-colors">Follow <%= shopName %></h4>
                        <p class="text-[11px] font-semibold text-rose-500">@<%= instagramUsername %></p>
                    </div>
                </a>

                <a href="<%= instagramUrl %>" target="_blank" rel="noopener noreferrer"
                    class="px-4 py-2.5 ig-gradient text-white rounded-xl text-xs font-bold tracking-wide transition-all flex items-center gap-1.5 active:scale-95 ig-glow shrink-0 hover:opacity-95">
                    <span>Follow</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
            </div>
        </div>
        <% } %>

        <% } %>

        <div class="text-center pt-2 pb-4 text-xs text-slate-400 font-medium">
            &copy; <%= new Date().getFullYear() %> <%= shopName %> &bull; Powered by <span class="font-bold text-slate-600">Astr</span>
        </div>
    </div>

    <script>
        function reviewPageData() {
            return {
                mode: 'random',
                customPrompt: '',
                generatedReview: '',
                loading: false,
                copied: false,
                copying: false,
                keyInput: '',
                accessKey: '<%= providedKey %>',
                reviewUrl: '<%= reviewUrl %>',
                popularServices: [
                    'Screen Replacement',
                    'Battery Service',
                    'Laptop Diagnostic & Repair',
                    'Custom PC Build',
                    'SSD & Speed Upgrade',
                    'Data Recovery'
                ],

                async init() {
                    <% if (isAuthorized) { %>
                    // Auto-generate initial review on load
                    await this.generateReview();
                    <% } %>
                },

                setMode(newMode) {
                    this.mode = newMode;
                    if (newMode === 'random' && !this.generatedReview) {
                        this.generateReview();
                    }
                },

                selectServiceChip(chip) {
                    this.customPrompt = chip;
                    this.generateReview();
                },

                submitKey() {
                    if (this.keyInput.trim()) {
                        window.location.href = `/reviews?key=${encodeURIComponent(this.keyInput.trim())}`;
                    }
                },

                async generateReview() {
                    this.loading = true;
                    this.copied = false;
                    try {
                        const response = await axios.post('/api/v1/reviews/generate', {
                            key: this.accessKey,
                            type: this.mode,
                            prompt: this.customPrompt
                        });

                        if (response.data && response.data.success && response.data.data) {
                            this.generatedReview = response.data.data.review;
                        } else {
                            throw new Error(response.data?.message || 'Failed to generate review');
                        }
                    } catch (error) {
                        console.error('Review generation error:', error);
                        // Safe fallback
                        this.generatedReview = "Outstanding service and super fast turnaround! The staff was knowledgeable, polite, and resolved my issue completely. Definitely my go-to tech shop!";
                    } finally {
                        this.loading = false;
                    }
                },

                async copyAndOpenReview() {
                    if (!this.generatedReview) return;
                    this.copying = true;
                    try {
                        await navigator.clipboard.writeText(this.generatedReview);
                        this.copied = true;
                        
                        // Micro delay for visual feedback before opening Google Reviews
                        setTimeout(() => {
                            if (this.reviewUrl) {
                                window.open(this.reviewUrl, '_blank');
                            }
                        }, 400);

                        setTimeout(() => {
                            this.copied = false;
                        }, 6000);
                    } catch (err) {
                        console.error('Clipboard copy failed:', err);
                        if (this.reviewUrl) {
                            window.open(this.reviewUrl, '_blank');
                        }
                    } finally {
                        this.copying = false;
                    }
                }
            };
        }
    </script>
</body>
</html>
