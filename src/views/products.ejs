                        class="group relative bg-white border border-gray-100 rounded-3xl p-8 hover:border-blue-200 transition-all duration-300 hover:shadow-xl hover:shadow-gray-100"
                      >
                        <div class="flex items-center justify-between mb-6">
                          <div>
                            <h3
                              class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1"
                            >
                              Equilibrium
                            </h3>
                            <p class="text-lg font-bold text-gray-900">
                              Balanced & Detailed
                            </p>
                          </div>
                          <button
                            @click="copyToClipboard(generatedAds.medium, 'medium')"
                            class="px-6 py-2.5 bg-gray-900 text-white text-xs font-bold rounded-xl hover:bg-black transition-all active:scale-95 flex items-center"
                          >
                            <i
                              :class="copiedMessage === 'medium' ? 'fas fa-check' : 'fas fa-copy'"
                              class="mr-2"
                            ></i>
                            <span
                              x-text="copiedMessage === 'medium' ? 'Copied' : 'Copy Text'"
                            ></span>
                          </button>
                        </div>
                        <p
                          class="text-gray-600 leading-relaxed font-light text-base"
                          x-text="generatedAds.medium"
                        ></p>
                      </div>

                      <!-- Long Message -->
                      <div
                        class="group relative bg-white border border-gray-100 rounded-3xl p-8 hover:border-blue-200 transition-all duration-300 hover:shadow-xl hover:shadow-gray-100"
                      >
                        <div class="flex items-center justify-between mb-6">
                          <div>
                            <h3
                              class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1"
                            >
                              Immersion
                            </h3>
                            <p class="text-lg font-bold text-gray-900">
                              Comprehensive Narrative
                            </p>
                          </div>
                          <button
                            @click="copyToClipboard(generatedAds.long, 'long')"
                            class="px-6 py-2.5 bg-gray-900 text-white text-xs font-bold rounded-xl hover:bg-black transition-all active:scale-95 flex items-center"
                          >
                            <i
                              :class="copiedMessage === 'long' ? 'fas fa-check' : 'fas fa-copy'"
                              class="mr-2"
                            ></i>
                            <span
                              x-text="copiedMessage === 'long' ? 'Copied' : 'Copy Text'"
                            ></span>
                          </button>
                        </div>
                        <p
                          class="text-gray-600 leading-relaxed font-light text-base"
                          x-text="generatedAds.long"
                        ></p>
                      </div>
                    </div>
                  </div>
                </div>

                <div
                  class="p-8 border-t border-gray-50 bg-gray-50/30 backdrop-blur-md flex justify-end"
                >
                  <button
                    @click="closeAdsModal()"
                    class="px-10 py-4 bg-gray-100 text-gray-600 text-sm font-bold rounded-2xl hover:bg-gray-200 transition-all"
                  >
                    Dismiss
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Import Preview Modal -->
  <template x-teleport="body">
    <div
      x-show="showImportPreview"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[9999] flex items-center justify-center p-4"
      @click.self="closeImportPreview()"
      style="display: none"
    >
              <div
                x-show="showImportPreview"
                x-transition:enter="transition ease-out duration-500 transform"
                x-transition:enter-start="opacity-0 translate-y-8 scale-95"
                x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                x-transition:leave="transition ease-in duration-300 transform"
                x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                class="bg-white rounded-[40px] shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col"
              >
                <!-- Modal Body -->
                <div class="overflow-y-auto flex-1">
                  <div class="p-8 md:p-12">
                    <div class="flex items-start justify-between mb-12">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-4">
                          <span
                            class="px-3 py-1 bg-blue-50 text-blue-600 text-[10px] font-bold rounded-full tracking-wider uppercase"
                            >Batch Import</span
                          >
                          <i
                            class="fas fa-file-import text-blue-400 text-xs"
                          ></i>
                        </div>
                        <h2
                          class="text-4xl font-bold text-gray-900 tracking-tight leading-tight"
                        >
                          Import Preview
                        </h2>
                        <p class="text-gray-500 mt-2 text-sm">
                          Review data integrity before confirming the operation
                        </p>
                      </div>

                      <button
                        @click="closeImportPreview()"
                        class="p-3 bg-gray-50 text-gray-400 hover:text-gray-900 rounded-full transition-colors group"
                      >
                        <i
                          class="fas fa-times text-xl group-hover:rotate-90 transition-transform duration-300"
                        ></i>
                      </button>
                    </div>

                    <div class="p-6 space-y-12" x-show="importPreviewData">
                      <!-- Summary Grid -->
                      <div class="grid grid-cols-3 gap-6">
                        <div
                          class="bg-gray-50 rounded-3xl p-6 border border-gray-100 text-center"
                        >
                          <div
                            class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2"
                          >
                            Total Items
                          </div>
                          <div
                            class="text-3xl font-bold text-gray-900"
                            x-text="importPreviewData?.totalRows || 0"
                          ></div>
                        </div>
                        <div
                          class="bg-green-50/50 rounded-3xl p-6 border border-green-100 text-center"
                        >
                          <div
                            class="text-[10px] font-bold text-green-500 uppercase tracking-widest mb-2"
                          >
                            Valid
                          </div>
                          <div
                            class="text-3xl font-bold text-green-600"
                            x-text="importPreviewData?.validRows || 0"
                          ></div>
                        </div>
                        <div
                          class="bg-red-50/50 rounded-3xl p-6 border border-red-100 text-center"
                        >
                          <div
                            class="text-[10px] font-bold text-red-500 uppercase tracking-widest mb-2"
                          >
                            Issues
                          </div>
                          <div
                            class="text-3xl font-bold text-red-600"
                            x-text="importPreviewData?.invalidRows?.length || 0"
                          ></div>
                        </div>
                      </div>

                      <!-- Content Sections -->
                      <div class="space-y-10">
                        <!-- Errors -->
                        <div
                          x-show="importPreviewData?.invalidRows?.length > 0"
                          class="space-y-4"
                        >
                          <label
                            class="block text-[10px] font-bold text-red-400 uppercase tracking-widest ml-1"
                            >Critical Validation Failures</label
                          >
                          <div
                            class="bg-white border border-red-100 rounded-3xl overflow-hidden divide-y divide-red-50"
                          >
                            <template
                              x-for="row in importPreviewData?.invalidRows"
                              :key="row.rowNumber"
                            >
                              <div
                                class="p-4 flex items-center justify-between group hover:bg-red-50/20 transition-colors"
                              >
                                <div class="flex items-center gap-4">
                                  <span
                                    class="text-[10px] font-bold text-red-300 border border-red-100 px-2 py-0.5 rounded-lg"
                                    x-text="`Row ${row.rowNumber}`"
                                  ></span>
                                  <span
                                    class="text-sm font-semibold text-gray-700"
                                    x-text="row.name"
                                  ></span>
                                </div>
                                <span
                                  class="text-xs text-red-500 italic"
                                  x-text="row.errors.join(', ')"
                                ></span>
                              </div>
                            </template>
                          </div>
                        </div>

                        <!-- Categories -->
                        <div
                          x-show="importPreviewData?.missingCategories?.length > 0"
                          class="space-y-4"
                        >
                          <label
                            class="block text-[10px] font-bold text-orange-400 uppercase tracking-widest ml-1"
                            >New Categories Detected</label
                          >
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <template
                              x-for="cat in importPreviewData?.missingCategories"
                              :key="cat"
                            >
                              <div
                                class="group flex items-center gap-3 bg-white border border-gray-100 p-4 rounded-2xl hover:border-orange-200 transition-all"
                              >
                                <div
                                  class="w-8 h-8 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500"
                                >
                                  <i class="fas fa-folder-plus text-xs"></i>
                                </div>
                                <div class="flex-1">
                                  <label
                                    class="block text-[9px] font-bold text-gray-400 uppercase mb-1"
                                    >Mapping Label</label
                                  >
                                  <input
                                    type="text"
                                    :value="cat"
                                    @input="categoryMappings[cat] = `CREATE:${$event.target.value}`"
                                    class="w-full text-sm font-semibold text-gray-800 bg-transparent border-none p-0 focus:ring-0"
                                  />
                                </div>
                              </div>
                            </template>
                          </div>
                        </div>

                        <!-- Sources -->
                        <div
                          x-show="importPreviewData?.missingSources?.length > 0"
                          class="space-y-4"
                        >
                          <label
                            class="block text-[10px] font-bold text-blue-400 uppercase tracking-widest ml-1"
                            >Unrecognized Provenance</label
                          >
                          <div class="grid grid-cols-1 gap-4">
                            <template
                              x-for="src in importPreviewData?.missingSources"
                              :key="src"
                            >
                              <div
                                class="bg-white border border-gray-100 p-6 rounded-3xl hover:border-blue-200 transition-all"
                              >
                                <div
                                  class="grid grid-cols-1 md:grid-cols-3 gap-6"
                                >
                                  <div>
                                    <label
                                      class="block text-[9px] font-bold text-gray-400 uppercase mb-2"
                                      >Display Name</label
                                    >
                                    <input
                                      type="text"
                                      :value="src"
                                      @input="updateSourceMapping(src, 'name', $event.target.value)"
                                      class="w-full text-sm font-semibold text-gray-800 bg-gray-50/50 border border-gray-100 px-4 py-2 rounded-xl focus:ring-4 focus:ring-blue-50 transition-all"
                                    />
                                  </div>
                                  <div>
                                    <label
                                      class="block text-[9px] font-bold text-gray-400 uppercase mb-2"
                                      >Communication</label
                                    >
                                    <input
                                      type="text"
                                      value="0000000000"
                                      @input="updateSourceMapping(src, 'phone', $event.target.value)"
                                      class="w-full text-sm font-semibold text-gray-800 bg-gray-50/50 border border-gray-100 px-4 py-2 rounded-xl focus:ring-4 focus:ring-blue-50 transition-all"
                                    />
                                  </div>
                                  <div>
                                    <label
                                      class="block text-[9px] font-bold text-gray-400 uppercase mb-2"
                                      >Relation Type</label
                                    >
                                    <select
                                      @change="updateSourceMapping(src, 'type', $event.target.value)"
                                      class="w-full text-sm font-semibold text-gray-800 bg-gray-50/50 border border-gray-100 px-4 py-2 rounded-xl focus:ring-4 focus:ring-blue-50 transition-all cursor-pointer"
                                    >
                                      <option value="Supplier">Supplier</option>
                                      <option value="Vendor">Vendor</option>
                                      <option value="Customer">Customer</option>
                                    </select>
                                  </div>
                                </div>
                              </div>
                            </template>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Sticky Footer -->
                <div
                  class="p-8 border-t border-gray-50 bg-gray-50/30 backdrop-blur-md"
                >
                  <div class="flex items-center justify-end gap-3">
                    <button
                      @click="closeImportPreview()"
                      class="px-8 py-4 bg-white border border-gray-200 text-gray-500 text-sm font-bold rounded-2xl hover:bg-gray-50 transition-all"
                    >
                      Abort
                    </button>
                    <button
                      @click="confirmImport()"
                      class="px-10 py-4 bg-blue-600 text-white text-sm font-bold rounded-2xl hover:bg-blue-700 shadow-xl shadow-blue-100 transition-all flex items-center"
                    >
                      <i class="fas fa-check-double mr-3"></i>
                      Confirm Integration
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </template>

  <script src="/js/pages/products.js"></script>
</div>
