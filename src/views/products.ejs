<div x-data="productsData" x-init="init()" class="space-y-6 pb-20 animate__animated animate__fadeIn">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
    <div>
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight font-display">Product Catalog & Inventory</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200/60">
          Stock Vault
        </span>
      </div>
      <p class="text-xs text-slate-500 mt-0.5">Manage live hardware inventory, technical attributes, and catalog valuation</p>
    </div>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Export Dropdown -->
      <div class="relative" x-data="{ open: false }" @click.away="open = false">
        <button @click="open = !open"
          class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 hover:border-primary-300 hover:text-primary-600 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 active:scale-95">
          <i class="fas fa-download text-xs text-slate-400"></i>
          <span>Export</span>
          <i class="fas fa-chevron-down text-[9px] text-slate-400 transition-transform duration-200 ml-0.5" :class="open ? 'rotate-180' : ''"></i>
        </button>
        <div x-show="open" x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95 translate-y-1"
          x-transition:enter-end="opacity-100 scale-100 translate-y-0"
          class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-200 z-50 overflow-hidden py-1">
          <button @click="exportProducts(false); open = false"
            class="w-full text-left px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center transition-colors">
            <i class="fas fa-file-csv mr-2.5 text-slate-400"></i>
            Full Database (CSV)
          </button>
          <button @click="exportToExcel(); open = false"
            class="w-full text-left px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center transition-colors">
            <i class="fas fa-file-excel mr-2.5 text-emerald-600"></i>
            Themed Excel
          </button>
          <button @click="exportToExcel(true); open = false"
            class="w-full text-left px-4 py-2.5 text-xs font-semibold text-primary-600 hover:bg-primary-50 flex items-center transition-colors border-t border-slate-100">
            <i class="fas fa-filter mr-2.5 text-primary-500"></i>
            Current Filtered View
          </button>
          <template x-if="filters.category">
            <button @click="exportProducts(true); open = false"
              class="w-full text-left px-4 py-2.5 text-xs font-semibold text-primary-600 hover:bg-primary-50 flex items-center transition-colors border-t border-slate-100">
              <i class="fas fa-file-export mr-2.5 text-primary-500"></i>
              Category Template
            </button>
          </template>
        </div>
      </div>

      <!-- Import Button -->
      <button @click="triggerImport()"
        class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 hover:border-primary-300 hover:text-primary-600 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 active:scale-95">
        <i class="fas fa-upload text-xs text-slate-400"></i>
        <span>Import</span>
      </button>
      <input type="file" x-ref="importFile" @change="importProducts($event)" class="hidden" accept=".csv" />

      <!-- Add Product Button -->
      <a href="/products/add"
        class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 flex items-center gap-2 active:scale-95">
        <i class="fas fa-plus text-xs"></i>
        <span>New Product</span>
      </a>
    </div>
  </div>

  <!-- 4-Card KPI Metric Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Total Items -->
    <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total Inventory</p>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl font-bold text-slate-900" x-text="stockSummary.totalItems">0</span>
          <span class="text-xs font-semibold text-slate-400">units</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-0.5">Registered in catalog</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl shrink-0">
        <i class="fas fa-boxes-stacked"></i>
      </div>
    </div>

    <!-- Available -->
    <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Available</p>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl font-bold text-emerald-600" x-text="stockSummary.available">0</span>
          <span class="text-xs font-semibold text-emerald-500">active</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-0.5">In stock & ready to quote</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
        <i class="fas fa-circle-check"></i>
      </div>
    </div>

    <!-- Sold Out -->
    <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Sold Out</p>
        <div class="flex items-baseline gap-2 mt-1">
          <span class="text-2xl font-bold text-slate-500" x-text="stockSummary.sold">0</span>
          <span class="text-xs font-semibold text-slate-400">archived</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-0.5">Fulfilled & dispatched</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-500 flex items-center justify-center text-xl shrink-0">
        <i class="fas fa-box-archive"></i>
      </div>
    </div>

    <!-- Total Valuation -->
    <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center justify-between">
      <div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Stock Valuation</p>
        <div class="flex items-baseline gap-1 mt-1 font-mono">
          <span class="text-slate-400 font-bold text-base">₹</span>
          <span class="text-2xl font-bold text-slate-900" x-text="formatNumber(stockSummary.totalValue)">0</span>
        </div>
        <p class="text-[11px] text-blue-600 font-semibold mt-0.5">Available inventory worth</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
        <i class="fas fa-indian-rupee-sign"></i>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white border border-slate-200/80 rounded-2xl p-4 shadow-2xs space-y-3">
    <!-- Main Controls Row -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 group">
        <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary-600 transition-colors text-xs"></i>
        <input type="text"
          x-model="filters.search"
          @input.debounce.400ms="resetAndLoad()"
          placeholder="Search products by model, serial, specifications..."
          class="w-full pl-9 pr-8 py-2 bg-slate-50/70 border border-slate-200/80 rounded-xl text-xs font-medium text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all">
        <button x-show="filters.search" @click="filters.search = ''; resetAndLoad()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
          <i class="fas fa-times text-xs"></i>
        </button>
      </div>

      <!-- Category Filter -->
      <div class="w-full sm:w-56">
        <select x-model="filters.category" @change="resetAndLoad()"
          :class="filters.category ? 'border-primary-400 bg-primary-50/20 text-primary-900 font-semibold' : 'border-slate-200/80 bg-slate-50/70 text-slate-700'"
          class="w-full px-3 py-2 border rounded-xl text-xs outline-none transition-all cursor-pointer font-medium focus:bg-white focus:border-primary-400 focus:ring-2 focus:ring-primary-100">
          <option value="">All Categories</option>
          <template x-for="cat in categories" :key="cat._id">
            <option :value="cat._id" x-text="cat.name" :selected="cat._id === filters.category"></option>
          </template>
        </select>
      </div>

      <!-- Availability Pills -->
      <div class="flex items-center p-1 bg-slate-100 rounded-xl border border-slate-200/70 text-xs shrink-0">
        <button type="button" @click="setAvailabilityFilter(null)"
          :class="filters.isSold === null ? 'bg-white text-slate-900 font-bold shadow-2xs' : 'text-slate-500 hover:text-slate-800'"
          class="px-3 py-1 rounded-lg transition-all">
          All
        </button>
        <button type="button" @click="setAvailabilityFilter(false)"
          :class="filters.isSold === false ? 'bg-white text-emerald-700 font-bold shadow-2xs' : 'text-slate-500 hover:text-slate-800'"
          class="px-3 py-1 rounded-lg transition-all">
          In Stock
        </button>
        <button type="button" @click="setAvailabilityFilter(true)"
          :class="filters.isSold === true ? 'bg-white text-slate-700 font-bold shadow-2xs' : 'text-slate-500 hover:text-slate-800'"
          class="px-3 py-1 rounded-lg transition-all">
          Sold
        </button>
      </div>

      <!-- Advanced Filters Toggle & View Switcher -->
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" @click="showFilters = !showFilters"
          :class="showFilters || activeFiltersCount > 0 ? 'bg-primary-50 text-primary-700 border-primary-200' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'"
          class="px-3 py-2 border rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 shadow-2xs">
          <i class="fas fa-sliders text-xs"></i>
          <span>Specs</span>
          <span x-show="activeFiltersCount > 0" class="px-1.5 py-0.2 rounded-full text-[10px] bg-primary-600 text-white font-mono" x-text="activeFiltersCount"></span>
          <i class="fas fa-chevron-down text-[9px] transition-transform" :class="showFilters ? 'rotate-180' : ''"></i>
        </button>

        <!-- View Mode Switcher -->
        <div class="flex items-center p-1 bg-slate-100 rounded-xl border border-slate-200/70 text-xs">
          <button @click="viewMode = 'grid'" title="Card View"
            :class="viewMode === 'grid' ? 'bg-white text-slate-900 font-bold shadow-2xs' : 'text-slate-400 hover:text-slate-700'"
            class="px-2.5 py-1 rounded-lg transition-all flex items-center gap-1">
            <i class="fas fa-grid-2 text-xs"></i>
          </button>
          <button @click="viewMode = 'list'" title="Table View"
            :class="viewMode === 'list' ? 'bg-white text-slate-900 font-bold shadow-2xs' : 'text-slate-400 hover:text-slate-700'"
            class="px-2.5 py-1 rounded-lg transition-all flex items-center gap-1">
            <i class="fas fa-list text-xs"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Collapsible Advanced Filters -->
    <div x-show="showFilters" x-collapse>
      <div class="pt-3 border-t border-slate-100 space-y-3 text-xs">
        <!-- Price Range & Quick Clear -->
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Price Range:</span>
            <div class="flex items-center gap-2">
              <div class="relative w-28">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-mono">₹</span>
                <input type="number" x-model="filters.minPrice" placeholder="Min" @input.debounce.400ms="resetAndLoad()"
                  class="w-full pl-6 pr-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:border-primary-400 focus:bg-white">
              </div>
              <span class="text-slate-400 text-xs">—</span>
              <div class="relative w-28">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-mono">₹</span>
                <input type="number" x-model="filters.maxPrice" placeholder="Max" @input.debounce.400ms="resetAndLoad()"
                  class="w-full pl-6 pr-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:border-primary-400 focus:bg-white">
              </div>
            </div>
          </div>

          <button x-show="activeFiltersCount > 0" @click="resetFilters()"
            class="text-[11px] font-bold text-rose-600 hover:text-rose-700 flex items-center gap-1">
            <i class="fas fa-rotate-left text-[10px]"></i>
            <span>Reset All Filters</span>
          </button>
        </div>

        <!-- Dynamic Spec Chips -->
        <div x-show="Object.keys(availableFilters).length > 0" class="space-y-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Specification Attributes:</span>
          <div class="flex flex-wrap gap-2">
            <template x-for="(values, key) in availableFilters" :key="key">
              <div class="relative" x-data="{ open: false }" @click.away="open = false">
                <button @click="open = !open"
                  :class="filters.specs[key]?.length > 0 ? 'border-primary-300 bg-primary-50 text-primary-700 font-bold' : 'border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100'"
                  class="px-2.5 py-1.5 rounded-lg border text-xs transition-all flex items-center gap-1.5">
                  <span x-text="formatFilterLabel(key)"></span>
                  <template x-if="filters.specs[key]?.length > 0">
                    <span class="px-1.5 py-0.2 rounded-full text-[9px] bg-primary-600 text-white font-mono" x-text="filters.specs[key].length"></span>
                  </template>
                  <i class="fas fa-chevron-down text-[8px] opacity-60 transition-transform" :class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-cloak
                  x-transition:enter="transition ease-out duration-100"
                  x-transition:enter-start="opacity-0 scale-95"
                  x-transition:enter-end="opacity-100 scale-100"
                  class="absolute left-0 mt-1.5 w-52 bg-white rounded-xl shadow-xl border border-slate-200 z-50 py-2 max-h-56 overflow-y-auto">
                  <template x-for="value in values" :key="value">
                    <label class="flex items-center px-3.5 py-1.5 hover:bg-slate-50 cursor-pointer text-xs">
                      <input type="checkbox"
                        :checked="filters.specs[key]?.includes(value)"
                        @change="toggleFilter(key, value)"
                        class="rounded border-slate-300 text-primary-600 focus:ring-primary-500 mr-2.5">
                      <span class="text-slate-700 font-medium truncate" x-text="value"></span>
                    </label>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Bar -->
  <div class="flex items-center justify-between text-xs text-slate-500">
    <p>
      Showing <strong class="text-slate-800" x-text="products.length"></strong> products
      <span x-show="filters.category || filters.search || filters.isSold !== null" class="text-primary-600 font-semibold">(filtered)</span>
    </p>
  </div>

  <!-- Loading State -->
  <div x-show="loading" class="flex flex-col items-center justify-center py-20 space-y-3">
    <div class="w-9 h-9 border-3 border-slate-200 border-t-primary-600 rounded-full animate-spin"></div>
    <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold">Loading catalog items...</p>
  </div>

  <!-- Empty State -->
  <div x-show="!loading && products.length === 0" class="bg-white border border-slate-200/80 rounded-2xl p-12 text-center shadow-xs">
    <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center mx-auto mb-3">
      <i class="fas fa-boxes-stacked text-lg"></i>
    </div>
    <h3 class="text-sm font-bold text-slate-900">No Products Found</h3>
    <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1 mb-4">No products match the selected criteria or search query.</p>
    <a href="/products/add" class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary-600 text-white rounded-xl text-xs font-bold hover:bg-primary-700 transition-all shadow-xs">
      <i class="fas fa-plus text-[10px]"></i>
      <span>Add New Product</span>
    </a>
  </div>

  <!-- Grid View -->
  <div x-show="!loading && viewMode === 'grid' && products.length > 0"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <template x-for="(product, index) in products" :key="product._id">
      <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-2xs hover:shadow-md hover:border-primary-200 transition-all cursor-pointer flex flex-col justify-between group"
        @click="viewProduct(product)">
        <div class="space-y-3">
          <!-- Top Tag & Status -->
          <div class="flex items-center justify-between">
            <span x-show="product.productID" class="font-mono text-xs font-bold text-slate-500" x-text="product.productID"></span>
            <span x-show="!product.productID" class="text-[10px] font-bold text-slate-400 uppercase">Item</span>

            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider"
              :class="product.isSold ? 'bg-slate-100 text-slate-600 border border-slate-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80'"
              x-text="product.isSold ? 'Sold' : 'In Stock'"></span>
          </div>

          <!-- Product Name -->
          <div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary-600 transition-colors line-clamp-2 leading-snug"
              x-text="product.name"></h3>
            <div class="flex items-center gap-1.5 mt-1.5">
              <span class="inline-flex items-center gap-1 text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md font-medium">
                <i class="fas fa-tag text-[9px] text-slate-400"></i>
                <span x-text="product.category?.name || 'Uncategorized'"></span>
              </span>
            </div>
          </div>

          <!-- Tags -->
          <div x-show="product.tags && product.tags.length > 0" class="flex flex-wrap gap-1 pt-1">
            <template x-for="tag in product.tags?.slice(0, 3)" :key="tag">
              <span class="px-2 py-0.5 bg-slate-50 border border-slate-200/70 text-slate-600 text-[10px] rounded-md font-medium" x-text="tag"></span>
            </template>
          </div>
        </div>

        <!-- Footer: Price & Actions -->
        <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between" @click.stop>
          <div class="flex items-baseline gap-0.5 font-mono">
            <span class="text-slate-400 text-xs font-bold">₹</span>
            <span class="text-lg font-bold text-slate-900" x-text="Number(product.price).toLocaleString('en-IN')"></span>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" @click="viewProduct(product)"
              class="px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-xs font-semibold transition-all shadow-2xs">
              View
            </button>
            <a :href="`/products/edit/${product._id}`" title="Edit Product"
              class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
              <i class="fas fa-pencil-alt text-xs"></i>
            </a>
            <button type="button" @click="showQROnly(product._id)" title="QR Code"
              class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
              <i class="fas fa-qrcode text-xs"></i>
            </button>
            <button x-show="!product.isSold" type="button" @click="markAsSold(product._id)" title="Mark Sold"
              class="w-7 h-7 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 flex items-center justify-center transition-colors">
              <i class="fas fa-check text-xs"></i>
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- List View (Table) -->
  <div x-show="!loading && viewMode === 'list' && products.length > 0"
    class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="bg-slate-50/70 border-b border-slate-200/80 text-slate-500 font-bold uppercase tracking-wider text-[10px]">
            <th class="px-5 py-3.5">Product</th>
            <th class="px-5 py-3.5 hidden md:table-cell">Category</th>
            <th class="px-5 py-3.5 hidden lg:table-cell">Source</th>
            <th class="px-5 py-3.5">Price</th>
            <th class="px-5 py-3.5">Status</th>
            <th class="px-5 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <template x-for="product in products" :key="product._id">
            <tr class="hover:bg-slate-50/60 transition-colors cursor-pointer group" @click="viewProduct(product)">
              <td class="px-5 py-3.5">
                <span class="font-semibold text-slate-900 block" x-text="product.name"></span>
                <span x-show="product.productID" class="text-[10px] font-mono text-slate-400" x-text="product.productID"></span>
              </td>
              <td class="px-5 py-3.5 hidden md:table-cell">
                <span class="text-xs text-slate-600" x-text="product.category?.name || '—'"></span>
              </td>
              <td class="px-5 py-3.5 hidden lg:table-cell">
                <span class="text-xs text-slate-500" x-text="product.source?.name || '—'"></span>
              </td>
              <td class="px-5 py-3.5 font-mono font-bold text-slate-900">
                ₹<span x-text="Number(product.price).toLocaleString('en-IN')"></span>
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider"
                  :class="product.isSold ? 'bg-slate-100 text-slate-600' : 'bg-emerald-50 text-emerald-700'"
                  x-text="product.isSold ? 'Sold' : 'Active'"></span>
              </td>
              <td class="px-5 py-3.5 text-right" @click.stop>
                <div class="flex items-center justify-end gap-1.5">
                  <button type="button" @click="viewProduct(product)"
                    class="px-2.5 py-1 bg-slate-100 hover:bg-primary-50 hover:text-primary-600 text-slate-700 rounded-lg text-xs font-semibold transition-all">
                    View
