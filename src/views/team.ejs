<script src="/js/pages/team.js"></script>

<div x-data="teamData" x-init="init()" class="space-y-6 pb-20 animate__animated animate__fadeIn">
    
    <!-- Top Action & Title Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div>
            <div class="flex items-center gap-2.5">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight font-display">Employees & Staff</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-primary-50 text-primary-700 border border-primary-200/60"
                    x-text="`${users.length} Total`">
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Manage employee profiles, roles, salaries, permissions, and shift attendance</p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <!-- Shift Attendance Controller -->
            <div class="flex items-center bg-slate-100/90 p-1 rounded-xl border border-slate-200/80 shadow-2xs">
                <template x-if="!attendanceStatus?.checkIn">
                    <button type="button" @click="performCheckIn()"
                        class="px-3.5 py-1.5 bg-white text-slate-800 rounded-lg text-xs font-bold hover:bg-emerald-600 hover:text-white transition-all shadow-2xs border border-slate-200 flex items-center gap-1.5 active:scale-95">
                        <i class="fas fa-play text-[10px] text-emerald-600"></i>
                        <span>Start Shift</span>
                    </button>
                </template>
                <template x-if="attendanceStatus?.checkIn && !attendanceStatus?.checkOut">
                    <button type="button" @click="performCheckOut()"
                        class="px-3.5 py-1.5 bg-amber-500 text-white rounded-lg text-xs font-bold hover:bg-amber-600 transition-all shadow-2xs flex items-center gap-1.5 active:scale-95">
                        <i class="fas fa-stop text-[10px]"></i>
                        <span>End Shift</span>
                    </button>
                </template>
                <template x-if="attendanceStatus?.checkOut">
                    <div class="px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-200 flex items-center gap-1.5">
                        <i class="fas fa-check-double text-[11px]"></i>
                        <span>Shift Completed</span>
                    </div>
                </template>
                <div x-show="attendanceStatus && attendanceStatus.checkIn && !attendanceStatus.checkOut"
                    class="px-3 hidden sm:flex items-center gap-1.5 border-l border-slate-200 text-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[11px] font-mono font-bold text-slate-700"
                        x-text="attendanceStatus && attendanceStatus.checkIn ? new Date(attendanceStatus.checkIn).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : ''"></span>
                </div>
            </div>

            <!-- Add Employee Button -->
            <button type="button" @click="openUserModal()"
                class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 flex items-center gap-2 active:scale-95">
                <i class="fas fa-user-plus text-xs"></i>
                <span>Add Employee</span>
            </button>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
            <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" x-model="filters.search"
                placeholder="Search employee by name, username, or role..."
                class="w-full pl-9 pr-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-primary-400 transition-colors shadow-2xs">
        </div>

        <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 scrollbar-hide">
            <!-- Department / Group Tabs -->
            <div class="flex items-center gap-1 bg-slate-100/90 p-1 rounded-xl border border-slate-200/80">
                <template x-for="g in ['All', ...groups]" :key="g">
                    <button type="button" @click="filters.group = g"
                        class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap"
                        :class="filters.group === g 
                            ? 'bg-white text-slate-900 shadow-2xs' 
                            : 'text-slate-500 hover:text-slate-800'">
                        <span x-text="g"></span>
                    </button>
                </template>
            </div>

            <!-- Show Resigned Toggle -->
            <button type="button" @click="filters.showResigned = !filters.showResigned"
                class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 border shadow-2xs whitespace-nowrap active:scale-95"
                :class="filters.showResigned 
                    ? 'bg-amber-50 border-amber-300 text-amber-800' 
                    : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'">
                <i class="fas text-[11px]" :class="filters.showResigned ? 'fa-eye' : 'fa-eye-slash'"></i>
                <span x-text="filters.showResigned ? 'Showing Inactive' : 'Hide Inactive'"></span>
            </button>
        </div>
    </div>

    <!-- Employee Directory Card -->
    <div class="bg-white border border-slate-200/90 rounded-2xl shadow-2xs overflow-hidden">
        <!-- Table Header (Desktop) -->
        <div class="hidden lg:grid grid-cols-12 gap-4 px-6 py-3.5 text-[11px] font-black text-slate-400 uppercase tracking-wider bg-slate-50/70 border-b border-slate-200/80">
            <div class="col-span-4">Employee Details</div>
            <div class="col-span-2">Role / Position</div>
            <div class="col-span-2 text-center">Salary & Rate</div>
            <div class="col-span-2 text-center">Accounts Ledger</div>
            <div class="col-span-2 text-right">Actions</div>
        </div>

        <!-- Loading State -->
        <div x-show="loading" class="flex flex-col items-center justify-center py-24 space-y-3">
            <div class="w-8 h-8 border-3 border-slate-200 border-t-primary-600 rounded-full animate-spin"></div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Loading Employees...</p>
        </div>

        <!-- Empty State -->
        <div x-show="!loading && filteredUsers().length === 0" class="py-24 text-center px-4">
            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-200 text-slate-300 text-2xl">
                <i class="fas fa-users-slash"></i>
            </div>
            <h4 class="text-sm font-bold text-slate-800">No employees found</h4>
            <p class="text-xs text-slate-400 mt-1">Try adjusting your search query or department filters.</p>
        </div>

        <!-- Employee Rows -->
        <div x-show="!loading && filteredUsers().length > 0" class="divide-y divide-slate-100">
            <template x-for="user in filteredUsers()" :key="user._id">
                <div class="group grid grid-cols-1 lg:grid-cols-12 gap-4 items-center px-6 py-4 hover:bg-slate-50/70 transition-colors"
                    :class="activeAuraIds.includes(user._id) ? 'bg-emerald-50/20' : ''">

                    <!-- Mobile Department Pill -->
                    <div class="lg:hidden flex items-center justify-between mb-2">
                        <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700"
                            x-text="user.group"></span>
                        <div x-show="activeAuraIds.includes(user._id)" class="flex items-center gap-1.5 text-xs font-bold text-emerald-600">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span>On Shift</span>
                        </div>
                    </div>

                    <!-- Col 1: Employee info -->
                    <div class="col-span-4 flex items-center gap-3.5">
                        <div class="relative shrink-0">
                            <div class="w-11 h-11 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center font-black text-base border border-primary-200/60 shadow-2xs group-hover:scale-105 transition-transform"
                                x-text="user.name ? user.name.charAt(0).toUpperCase() : '?'"></div>
                            <!-- Active Status Dot -->
                            <div class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full border-2 border-white flex items-center justify-center text-[7px] text-white shadow-xs"
                                :class="user.status === 'Resigned' ? 'bg-rose-500' : (activeAuraIds.includes(user._id) ? 'bg-emerald-500 animate-pulse' : (user.isActive ? 'bg-emerald-500' : 'bg-slate-300'))">
                                <i class="fas" :class="user.status === 'Resigned' ? 'fa-xmark' : (user.isActive ? 'fa-check' : 'fa-minus')"></i>
                            </div>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-bold text-slate-900 truncate" x-text="user.name"></h4>
                                <span x-show="activeAuraIds.includes(user._id)"
                                    class="hidden sm:inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                    On Shift
                                </span>
                            </div>
                            <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
                                <span class="font-mono text-slate-400" x-text="'@' + user.username"></span>
                                <span class="text-slate-300">•</span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700"
                                    x-text="user.group"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Col 2: Position -->
                    <div class="col-span-2 hidden lg:block">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold border"
                            :class="{
                                'bg-purple-50 text-purple-700 border-purple-200/80': user.position === 'Admin',
                                'bg-blue-50 text-blue-700 border-blue-200/80': user.position === 'Technician',
                                'bg-emerald-50 text-emerald-700 border-emerald-200/80': user.position === 'Sales',
                                'bg-amber-50 text-amber-700 border-amber-200/80': user.position === 'Manager',
                                'bg-slate-100 text-slate-700 border-slate-200': user.position === 'Staff' || !user.position
                            }"
                            x-text="user.position || 'Staff'"></span>
                    </div>

                    <!-- Col 3: Salary & Rate -->
                    <div class="col-span-2 text-center hidden lg:block">
                        <span class="font-mono font-bold text-slate-900 text-sm" x-text="'₹' + Number(user.salaryConfig?.amount || 0).toLocaleString('en-IN')"></span>
                        <span class="text-[10px] text-slate-400 block font-medium uppercase tracking-wider"
                            x-text="user.salaryConfig?.type === 'daily' ? 'Per Day' : 'Per Month'"></span>
                    </div>

                    <!-- Col 4: Accounts Ledger -->
                    <div class="col-span-2 text-center flex items-center justify-center">
                        <template x-if="user.accountId">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <i class="fas fa-circle-check text-emerald-600"></i>
                                <span>Accounts Linked</span>
                            </span>
                        </template>
                        <template x-if="!user.accountId">
                            <button type="button" @click="syncLedger(user)"
                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 transition-colors active:scale-95 shadow-2xs">
                                <i class="fas fa-triangle-exclamation text-amber-600"></i>
                                <span>Link Ledger</span>
                            </button>
                        </template>
                    </div>

                    <!-- Col 5: Actions -->
                    <div class="col-span-2 flex items-center justify-end gap-1.5">
                        <!-- Payroll Summary -->
                        <button type="button" @click="viewProfile(user)" title="Payroll & Attendance"
                            class="w-8 h-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-800 border border-slate-200 flex items-center justify-center text-xs transition-colors shadow-2xs">
                            <i class="fas fa-chart-pie"></i>
                        </button>

                        <!-- Permissions -->
                        <button type="button" @click="openPermissionMatrix(user)" title="Permissions"
                            class="w-8 h-8 rounded-lg bg-slate-50 hover:bg-primary-50 text-slate-500 hover:text-primary-600 border border-slate-200 hover:border-primary-200 flex items-center justify-center text-xs transition-colors shadow-2xs">
                            <i class="fas fa-shield-halved"></i>
                        </button>

                        <!-- Edit -->
                        <button type="button" @click="openUserModal(user)" title="Edit Employee"
                            class="w-8 h-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-800 border border-slate-200 flex items-center justify-center text-xs transition-colors shadow-2xs">
                            <i class="fas fa-pen"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div class="relative" x-data="{ open: false }">
                            <button type="button" @click="open = !open" @click.away="open = false" title="More Options"
                                class="w-8 h-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-800 border border-slate-200 flex items-center justify-center text-xs transition-colors shadow-2xs">
                                <i class="fas fa-ellipsis-vertical"></i>
                            </button>
                            <div x-show="open" style="display: none;"
                                class="absolute right-0 top-full mt-1.5 w-48 bg-white rounded-xl shadow-lg border border-slate-200 p-1.5 z-50 flex flex-col gap-0.5 text-xs">
                                <button type="button" @click="openPasswordReset(user); open = false"
                                    class="w-full px-3 py-2 text-left rounded-lg hover:bg-slate-50 text-slate-700 font-semibold flex items-center justify-between transition-colors">
                                    <span>Reset Password</span>
                                    <i class="fas fa-key text-[11px] text-slate-400"></i>
                                </button>
                                <button type="button" @click="updateStatus(user, user.status === 'Resigned' ? 'Active' : 'Resigned'); open = false"
                                    class="w-full px-3 py-2 text-left rounded-lg hover:bg-amber-50 text-amber-700 font-semibold flex items-center justify-between transition-colors">
                                    <span x-text="user.status === 'Resigned' ? 'Restore Active' : 'Mark as Resigned'"></span>
                                    <i class="fas text-[11px]" :class="user.status === 'Resigned' ? 'fa-user-check' : 'fa-user-slash'"></i>
                                </button>
                                <div class="h-px bg-slate-100 my-1"></div>
                                <button type="button" @click="deleteUser(user); open = false"
                                    class="w-full px-3 py-2 text-left rounded-lg hover:bg-rose-50 text-rose-600 font-semibold flex items-center justify-between transition-colors">
                                    <span>Delete Employee</span>
                                    <i class="fas fa-trash-can text-[11px]"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- Modals -->

    <!-- 1. Add / Edit Employee Modal -->
    <div x-show="modals.user" class="fixed inset-0 z-[100] flex items-center justify-center p-4" x-cloak style="display: none;">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" @click="modals.user = false"></div>
        <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 space-y-5 z-10 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-sm">
                        <i class="fas fa-user-gear"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900" x-text="editMode ? 'Edit Employee' : 'Add New Employee'"></h3>
                        <p class="text-[11px] text-slate-400">Employee profile, role, and salary details</p>
                    </div>
                </div>
                <button type="button" @click="modals.user = false" class="text-slate-400 hover:text-slate-600">
                    <i class="fas fa-xmark text-sm"></i>
                </button>
            </div>

            <form @submit.prevent="saveUser()" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Full Name</label>
                        <input type="text" x-model="userForm.name" required placeholder="e.g. John Doe"
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                    </div>
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Username</label>
                        <input type="text" x-model="userForm.username" :disabled="editMode" required placeholder="e.g. johndoe"
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400 disabled:opacity-50">
                    </div>
                </div>

                <div x-show="!editMode" class="space-y-1">
                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Login Password</label>
                    <input type="password" x-model="userForm.password" :required="!editMode" placeholder="Enter secure password"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Department / Group</label>
                        <select x-model="userForm.group" required
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                            <template x-for="g in groups" :key="g">
                                <option :value="g" x-text="g"></option>
                            </template>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Role / Position</label>
                        <select x-model="userForm.position" required
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                            <option value="Staff">Staff</option>
                            <option value="Technician">Technician</option>
                            <option value="Sales">Sales</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Salary Type</label>
                        <select x-model="userForm.salaryConfig.type" required
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                            <option value="daily">Daily Rate</option>
                            <option value="monthly">Monthly Salary</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Salary Amount (₹)</label>
                        <input type="number" min="0" x-model="userForm.salaryConfig.amount" required placeholder="0"
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" @click="modals.user = false"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                        Cancel
                    </button>
                    <button type="submit" :disabled="saving"
                        class="px-5 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 flex items-center gap-1.5 active:scale-95 disabled:opacity-50">
                        <i :class="saving ? 'fas fa-spinner fa-spin' : 'fas fa-check'" class="text-[10px]"></i>
                        <span x-text="saving ? 'Saving...' : 'Save Employee'"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. Permission Matrix Modal -->
    <div x-show="modals.permissions" class="fixed inset-0 z-[100] flex items-center justify-center p-4" x-cloak style="display: none;">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" @click="modals.permissions = false"></div>
        <div class="relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 space-y-5 z-10 max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-sm">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Employee Permissions</h3>
                        <p class="text-[11px] text-slate-400">Configure feature access for <span class="font-bold text-slate-700" x-text="selectedUser?.name"></span></p>
                    </div>
                </div>
                <button type="button" @click="modals.permissions = false" class="text-slate-400 hover:text-slate-600">
                    <i class="fas fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto pr-2 space-y-6">
                <template x-for="(perms, category) in permissionTree" :key="category">
                    <div class="space-y-3">
                        <h4 class="text-[11px] font-black text-slate-400 uppercase tracking-wider" x-text="category"></h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                            <template x-for="perm in permList(perms)" :key="perm.id">
                                <label class="flex items-center justify-between p-3.5 bg-slate-50/70 border border-slate-200/80 rounded-xl cursor-pointer hover:bg-white hover:border-primary-300 transition-all">
                                    <div class="pr-3">
                                        <p class="text-xs font-bold text-slate-800" x-text="perm.label"></p>
                                        <p class="text-[11px] text-slate-400 mt-0.5" x-text="perm.description"></p>
                                    </div>
                                    <input type="checkbox" :value="perm.id" x-model="selectedPermissions"
                                        class="w-4 h-4 text-primary-600 rounded cursor-pointer shrink-0">
                                </label>
                            </template>
                        </div>
                    </div>
                </template>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                <button type="button" @click="modals.permissions = false"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                    Cancel
                </button>
                <button type="button" @click="savePermissions()"
                    class="px-5 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 active:scale-95">
                    Save Permissions
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Reset Password Modal -->
    <div x-show="modals.password" class="fixed inset-0 z-[100] flex items-center justify-center p-4" x-cloak style="display: none;">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" @click="modals.password = false"></div>
        <div class="relative w-full max-w-sm bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 space-y-4 z-10">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
                        <i class="fas fa-key"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Reset Password</h3>
                        <p class="text-[11px] text-slate-400">For user: <span class="font-bold text-slate-700" x-text="selectedUser?.username"></span></p>
                    </div>
                </div>
                <button type="button" @click="modals.password = false" class="text-slate-400 hover:text-slate-600">
                    <i class="fas fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="space-y-1.5">
                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">New Password</label>
                <input type="password" x-model="passwordForm.newPassword" placeholder="Enter new password"
                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-primary-400">
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                <button type="button" @click="modals.password = false"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                    Cancel
                </button>
                <button type="button" @click="resetPassword()"
                    class="px-5 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 active:scale-95">
                    Save Password
                </button>
            </div>
        </div>
    </div>

    <!-- 4. Payroll & Attendance Summary Modal -->
    <div x-show="modals.profile" class="fixed inset-0 z-[100] flex items-center justify-center p-4" x-cloak style="display: none;">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" @click="modals.profile = false"></div>
        <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 space-y-5 z-10">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center font-bold text-base shadow-2xs"
                        x-text="selectedUser?.name ? selectedUser.name.charAt(0).toUpperCase() : '?'"></div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900" x-text="selectedUser?.name"></h3>
                        <p class="text-[11px] text-slate-400">
                            <span x-text="selectedUser?.position"></span>
                            <span> • </span>
                            <span x-text="selectedUser?.group"></span>
                        </p>
                    </div>
                </div>
                <button type="button" @click="modals.profile = false" class="text-slate-400 hover:text-slate-600">
                    <i class="fas fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <!-- Earned Salary Card -->
                <div class="p-4 bg-primary-600 text-white rounded-xl shadow-xs space-y-1">
                    <span class="text-[10px] font-black uppercase tracking-widest text-primary-100">Earned This Month</span>
                    <div class="text-2xl font-extrabold tracking-tight font-mono">
                        ₹<span x-text="Number(payrollData?.earnedSalary || 0).toLocaleString('en-IN')"></span>
                    </div>
                    <p class="text-[11px] text-primary-100/80 pt-1">
                        <span class="font-bold text-white" x-text="payrollData?.daysPresent || 0"></span> days present recorded
                    </p>
                </div>

                <!-- Accounting Account Card -->
                <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl flex flex-col justify-between space-y-2">
                    <div>
                        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Accounts Status</span>
                        <div class="flex items-center gap-1.5 text-xs font-bold"
                            :class="selectedUser?.accountId ? 'text-emerald-700' : 'text-amber-700'">
                            <i class="fas" :class="selectedUser?.accountId ? 'fa-circle-check text-emerald-600' : 'fa-triangle-exclamation text-amber-600'"></i>
                            <span x-text="selectedUser?.accountId ? 'Ledger Linked' : 'Not Linked'"></span>
                        </div>
                    </div>
                    <button type="button" @click="syncLedger(selectedUser)" x-show="!selectedUser?.accountId"
                        class="w-full py-1.5 bg-white border border-slate-200 hover:bg-primary-50 hover:text-primary-600 hover:border-primary-200 text-slate-700 rounded-lg text-xs font-bold transition-all shadow-2xs">
                        Link to Accounts
                    </button>
                    <div x-show="selectedUser?.accountId" class="text-[10px] text-slate-400">
                        Verified in Accounts Ledger
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end pt-2 border-t border-slate-100">
                <button type="button" @click="modals.profile = false"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
