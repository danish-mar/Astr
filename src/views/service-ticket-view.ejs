<script src="/js/pages/service-ticket-view.js"></script>

<div x-data="serviceTicketViewData" x-init="init()" class="space-y-6 pb-20 animate__animated animate__fadeIn">
    
    <!-- Top Action & Title Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div class="flex items-center gap-3">
            <a href="/service-tickets"
                class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition-all active:scale-95 group"
                title="Back to repairs">
                <i class="fas fa-arrow-left text-xs group-hover:-translate-x-0.5 transition-transform"></i>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-black text-slate-900 tracking-tight font-display">
                        Service Ticket <span class="font-mono text-primary-600" x-text="ticket ? '#' + ticket.ticketNumber : ''"></span>
                    </h1>
                    <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider"
                        :class="{
                            'bg-amber-50 text-amber-700 border border-amber-200/80': ticket?.status === 'Pending',
                            'bg-blue-50 text-blue-700 border border-blue-200/80': ticket?.status === 'In Progress',
                            'bg-emerald-50 text-emerald-700 border border-emerald-200/80': ticket?.status === 'Completed',
                            'bg-slate-100 text-slate-700 border border-slate-300': ticket?.status === 'Delivered',
                            'bg-rose-50 text-rose-700 border border-rose-200/80': ticket?.status === 'Cancelled'
                        }" x-text="ticket?.status || 'Loading...'"></span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">
                    <span x-text="ticket?.customer?.name || 'Walk-in Client'"></span>
                    <span class="text-slate-300 mx-1.5">•</span>
                    <span>Received: </span><span class="font-medium text-slate-700" x-text="formatDate(ticket?.createdAt)"></span>
                </p>
            </div>
        </div>

        <!-- Action Toolbar -->
        <div class="flex items-center gap-2">
            <button type="button" @click="openWhatsApp()"
                class="px-3.5 py-2 bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 active:scale-95 shadow-2xs">
                <i class="fab fa-whatsapp text-sm"></i>
                <span>WhatsApp Client</span>
            </button>

            <button type="button" @click="window.print()"
                class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 hover:border-primary-300 hover:text-primary-600 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5 active:scale-95">
                <i class="fas fa-print text-xs text-slate-400"></i>
                <span>Print Slip</span>
            </button>

            <button type="button" @click="editTicket()"
                class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-primary-200 flex items-center gap-1.5 active:scale-95">
                <i class="fas fa-pen text-[10px]"></i>
                <span>Edit Ticket</span>
            </button>
        </div>
    </div>

    <!-- Loading State -->
    <div x-show="loading" class="flex flex-col items-center justify-center py-28 space-y-3">
        <div class="w-10 h-10 border-3 border-slate-200 border-t-primary-600 rounded-full animate-spin"></div>
        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Loading Service Dossier...</p>
    </div>

    <!-- Main Content Grid -->
    <div x-show="!loading && ticket" class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        
        <!-- Left Column: Pipeline Stepper, Hardware Specs & Activity Log (8 cols) -->
        <div class="lg:col-span-8 space-y-5">
            
            <!-- 1. Lifecycle Progress Banner (Clean Light Enterprise Stepper) -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-3.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-md bg-primary-50 text-primary-600 flex items-center justify-center text-xs">
                            <i class="fas fa-arrows-split-up-and-left"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-900 uppercase tracking-wider font-display">Repair Stage Progression</span>
                    </div>
                    <span class="text-[11px] font-mono text-primary-700 font-bold bg-primary-50 px-2 py-0.5 rounded-md border border-primary-200/60"
                        x-text="`Stage ${getStageIndex(ticket?.status)} of 4`"></span>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div class="bg-primary-600 h-2 rounded-full transition-all duration-500"
                        :style="`width: ${getStagePercent(ticket?.status)}%`"></div>
                </div>

                <!-- 4 Step Buttons -->
                <div class="grid grid-cols-4 gap-2 pt-1">
                    <button type="button" @click="updateStatus('Pending')"
                        class="p-2.5 rounded-xl text-center transition-all flex flex-col items-center gap-1 border"
                        :class="ticket?.status === 'Pending' 
                            ? 'bg-amber-50 border-amber-300 text-amber-800 font-bold shadow-xs' 
                            : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                        <i class="fas fa-inbox text-xs" :class="ticket?.status === 'Pending' ? 'text-amber-600' : 'text-slate-400'"></i>
                        <span class="text-[11px]">1. Intake</span>
                    </button>

                    <button type="button" @click="updateStatus('In Progress')"
                        class="p-2.5 rounded-xl text-center transition-all flex flex-col items-center gap-1 border"
                        :class="ticket?.status === 'In Progress' 
                            ? 'bg-blue-50 border-blue-300 text-blue-800 font-bold shadow-xs' 
                            : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                        <i class="fas fa-screwdriver-wrench text-xs" :class="ticket?.status === 'In Progress' ? 'text-blue-600 animate-pulse' : 'text-slate-400'"></i>
                        <span class="text-[11px]">2. Bench</span>
                    </button>

                    <button type="button" @click="updateStatus('Completed')"
                        class="p-2.5 rounded-xl text-center transition-all flex flex-col items-center gap-1 border"
                        :class="ticket?.status === 'Completed' 
                            ? 'bg-emerald-50 border-emerald-300 text-emerald-800 font-bold shadow-xs' 
                            : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                        <i class="fas fa-circle-check text-xs" :class="ticket?.status === 'Completed' ? 'text-emerald-600' : 'text-slate-400'"></i>
                        <span class="text-[11px]">3. Ready</span>
                    </button>

                    <button type="button" @click="updateStatus('Delivered')"
                        class="p-2.5 rounded-xl text-center transition-all flex flex-col items-center gap-1 border"
                        :class="ticket?.status === 'Delivered' 
                            ? 'bg-slate-100 border-slate-400 text-slate-900 font-bold shadow-xs' 
                            : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                        <i class="fas fa-box text-xs" :class="ticket?.status === 'Delivered' ? 'text-slate-900' : 'text-slate-400'"></i>
                        <span class="text-[11px]">4. Delivered</span>
                    </button>
                </div>
            </div>

            <!-- 2. Hardware Diagnosis & Device Specs Card -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-2xs space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 border border-primary-200/60 flex items-center justify-center text-base">
                            <i :class="getDeviceIcon(ticket?.deviceDetails)"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 font-display">Hardware Diagnosis & Description</h2>
                            <p class="text-xs text-slate-500">Defect manifestation documented during intake</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg uppercase tracking-wider"
                        x-text="getDeviceCategory(ticket?.deviceDetails)"></span>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Device & Job Description</label>
                        <div class="p-4 bg-slate-50/80 border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-900 leading-relaxed"
                            x-text="ticket?.deviceDetails"></div>
                    </div>

                    <div x-show="ticket?.notes">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Internal Workshop Remarks</label>
                        <div class="p-4 bg-amber-50/40 border border-amber-200/70 rounded-xl text-xs text-slate-700 italic leading-relaxed"
                            x-text="ticket?.notes"></div>
                    </div>

                    <!-- 3-Item Metadata Pills -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-0.5">Assigned Technician</span>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <i class="fas fa-user-gear text-xs text-slate-400"></i>
                                <span class="text-xs font-bold text-slate-800 truncate" x-text="getTechnicianName(ticket?.assignedTechnician)"></span>
                            </div>
                        </div>

                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-0.5">Intake Date</span>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <i class="fas fa-calendar-check text-xs text-slate-400"></i>
                                <span class="text-xs font-bold text-slate-800" x-text="formatDate(ticket?.createdAt)"></span>
                            </div>
                        </div>

                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-0.5">Job Reference</span>
                            <div class="flex items-center justify-between mt-0.5">
                                <span class="font-mono text-xs font-bold text-primary-600" x-text="'TAG #' + ticket?.ticketNumber"></span>
                                <button type="button" @click="copyTicketNumber(ticket?.ticketNumber)" class="text-slate-400 hover:text-slate-700 text-xs">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2.5 External Workshop / Outsourced Repair Card -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-2xs space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 border border-purple-200/60 flex items-center justify-center text-base">
                            <i class="fas fa-truck-fast"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-bold text-slate-900 font-display">External Workshop / Outsourced Repair</h2>
                                <span x-show="ticket?.outsourcedRepair?.isOutsourced"
                                    class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider"
                                    :class="{
                                        'bg-purple-50 text-purple-700 border border-purple-200': ticket?.outsourcedRepair?.custodyLocation === 'At Partner Shop',
                                        'bg-slate-100 text-slate-700 border border-slate-200': ticket?.outsourcedRepair?.custodyLocation === 'In-House',
                                        'bg-emerald-50 text-emerald-700 border border-emerald-200': ticket?.outsourcedRepair?.custodyLocation === 'Received Back'
                                    }"
                                    x-text="ticket?.outsourcedRepair?.custodyLocation === 'At Partner Shop' ? 'At External Shop' : (ticket?.outsourcedRepair?.custodyLocation || 'In-House')"></span>
                            </div>
                            <p class="text-xs text-slate-500">Track device custody location & partner diagnostic outcome</p>
                        </div>
                    </div>
                    <button type="button" @click="openOutsourceModal()"
                        class="px-3 py-1.5 rounded-xl border text-xs font-bold transition-all flex items-center gap-1.5 shadow-2xs active:scale-95"
                        :class="ticket?.outsourcedRepair?.isOutsourced 
                            ? 'bg-purple-50 border-purple-200 text-purple-700 hover:bg-purple-100' 
                            : 'bg-white border-slate-200 text-slate-700 hover:border-purple-300 hover:text-purple-600'">
                        <i class="fas" :class="ticket?.outsourcedRepair?.isOutsourced ? 'fa-sliders' : 'fa-plus'"></i>
                        <span x-text="ticket?.outsourcedRepair?.isOutsourced ? 'Manage Tracking' : 'Send to 3rd-Party'"></span>
                    </button>
                </div>

                <!-- When NOT outsourced yet -->
                <div x-show="!ticket?.outsourcedRepair?.isOutsourced" class="p-5 bg-slate-50/70 border border-slate-200/70 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-slate-200/80 text-slate-500 flex items-center justify-center text-xs">
                            <i class="fas fa-warehouse"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-slate-800">Current Custody: In-House Workshop</h4>
                            <p class="text-[11px] text-slate-400">Device is handled directly by your internal technicians.</p>
                        </div>
                    </div>
                    <button type="button" @click="openOutsourceModal()"
                        class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 shrink-0">
                        <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
                        <span>Dispatch to External Shop</span>
                    </button>
                </div>

                <!-- When OUTSOURCED -->
                <div x-show="ticket?.outsourcedRepair?.isOutsourced" class="space-y-4">
                    <!-- 1. Physical Custody Stepper / Pills -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">1. Physical Custody Location ("Where is it?")</label>
                            <span class="text-[11px] text-slate-500 font-medium" x-text="ticket?.outsourcedRepair?.custodyLocation === 'At Partner Shop' ? 'Currently at external shop' : (ticket?.outsourcedRepair?.custodyLocation === 'Received Back' ? 'Returned to your workshop' : 'At internal bench')"></span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <!-- In-House -->
                            <button type="button" @click="quickSetCustody('In-House')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.custodyLocation === 'In-House'
                                    ? 'bg-slate-100 border-slate-400 text-slate-900 font-bold shadow-xs'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-warehouse text-xs" :class="ticket?.outsourcedRepair?.custodyLocation === 'In-House' ? 'text-slate-800' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Still in Shop</span>
                            </button>

                            <!-- At Partner Shop -->
                            <button type="button" @click="quickSetCustody('At Partner Shop')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.custodyLocation === 'At Partner Shop'
                                    ? 'bg-purple-50 border-purple-400 text-purple-900 font-bold shadow-xs ring-1 ring-purple-300'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-truck-fast text-xs" :class="ticket?.outsourcedRepair?.custodyLocation === 'At Partner Shop' ? 'text-purple-600 animate-pulse' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Still There</span>
                            </button>

                            <!-- Received Back -->
                            <button type="button" @click="quickSetCustody('Received Back')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.custodyLocation === 'Received Back'
                                    ? 'bg-emerald-50 border-emerald-400 text-emerald-900 font-bold shadow-xs'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-box-check text-xs" :class="ticket?.outsourcedRepair?.custodyLocation === 'Received Back' ? 'text-emerald-600' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Given Here</span>
                            </button>
                        </div>
                    </div>

                    <!-- 2. Diagnostic Progress & Outcome ("repaired, not repaired, cant repair") -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">2. External Diagnostic Progress & Outcome</label>
                            <span class="text-[11px] font-mono font-bold"
                                :class="{
                                    'text-blue-600': ticket?.outsourcedRepair?.repairOutcome === 'In Progress' || ticket?.outsourcedRepair?.repairOutcome === 'Pending',
                                    'text-emerald-600': ticket?.outsourcedRepair?.repairOutcome === 'Repaired',
                                    'text-rose-600': ticket?.outsourcedRepair?.repairOutcome === 'Cant Repair',
                                    'text-amber-600': ticket?.outsourcedRepair?.repairOutcome === 'Not Repaired'
                                }"
                                x-text="ticket?.outsourcedRepair?.repairOutcome === 'Cant Repair' ? 'CAN\'T REPAIR' : (ticket?.outsourcedRepair?.repairOutcome || 'PENDING')"></span>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <!-- In Progress / Diagnosing -->
                            <button type="button" @click="quickSetOutcome('In Progress')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.repairOutcome === 'In Progress' || ticket?.outsourcedRepair?.repairOutcome === 'Pending'
                                    ? 'bg-blue-50 border-blue-400 text-blue-900 font-bold shadow-xs'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-magnifying-glass text-xs" :class="ticket?.outsourcedRepair?.repairOutcome === 'In Progress' ? 'text-blue-600' : 'text-slate-400'"></i>
                                <span class="text-[11px]">In Diagnostic</span>
                            </button>

                            <!-- Repaired -->
                            <button type="button" @click="quickSetOutcome('Repaired')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.repairOutcome === 'Repaired'
                                    ? 'bg-emerald-50 border-emerald-400 text-emerald-900 font-bold shadow-xs ring-1 ring-emerald-300'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-circle-check text-xs" :class="ticket?.outsourcedRepair?.repairOutcome === 'Repaired' ? 'text-emerald-600' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Repaired</span>
                            </button>

                            <!-- Not Repaired -->
                            <button type="button" @click="quickSetOutcome('Not Repaired')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.repairOutcome === 'Not Repaired'
                                    ? 'bg-amber-50 border-amber-400 text-amber-900 font-bold shadow-xs'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-rotate-left text-xs" :class="ticket?.outsourcedRepair?.repairOutcome === 'Not Repaired' ? 'text-amber-600' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Not Repaired</span>
                            </button>

                            <!-- Can't Repair -->
                            <button type="button" @click="quickSetOutcome('Cant Repair')"
                                class="p-2.5 rounded-xl border text-center transition-all flex flex-col items-center gap-1"
                                :class="ticket?.outsourcedRepair?.repairOutcome === 'Cant Repair'
                                    ? 'bg-rose-50 border-rose-400 text-rose-900 font-bold shadow-xs ring-1 ring-rose-300'
                                    : 'bg-slate-50/70 hover:bg-slate-100 border-slate-200/70 text-slate-600'">
                                <i class="fas fa-ban text-xs" :class="ticket?.outsourcedRepair?.repairOutcome === 'Cant Repair' ? 'text-rose-600' : 'text-slate-400'"></i>
                                <span class="text-[11px]">Can't Repair</span>
                            </button>
                        </div>
                    </div>

                    <!-- 3. Partner Metadata Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                        <!-- Partner Name & Phone -->
                        <div class="p-3 bg-purple-50/40 rounded-xl border border-purple-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-purple-600 block mb-0.5">Partner Workshop</span>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-900 truncate" x-text="ticket?.outsourcedRepair?.partnerShopName || 'Not Assigned'"></span>
                                <a x-show="ticket?.outsourcedRepair?.partnerContact" :href="`tel:${ticket?.outsourcedRepair?.partnerContact}`" class="text-purple-600 hover:text-purple-800 text-xs">
                                    <i class="fas fa-phone"></i>
                                </a>
                            </div>
                            <span x-show="ticket?.outsourcedRepair?.partnerContact" class="text-[10px] font-mono text-slate-500 block mt-0.5" x-text="ticket?.outsourcedRepair?.partnerContact"></span>
                        </div>

                        <!-- Job / RMA Reference # -->
                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-0.5">Partner Job / RMA Ref</span>
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-xs font-bold text-slate-800 truncate" x-text="ticket?.outsourcedRepair?.externalJobNumber || '—'"></span>
                                <button type="button" x-show="ticket?.outsourcedRepair?.externalJobNumber" @click="copyTicketNumber(ticket?.outsourcedRepair?.externalJobNumber)" class="text-slate-400 hover:text-slate-700 text-xs">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <span class="text-[10px] text-slate-400 block mt-0.5" x-text="'Sent: ' + formatDate(ticket?.outsourcedRepair?.sentDate)"></span>
                        </div>

                        <!-- Vendor Cost & Expected Return -->
                        <div class="p-3 bg-slate-50/70 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-0.5">Partner Fee & Return ETA</span>
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-xs font-bold text-slate-800" x-text="'₹' + formatCurrency(ticket?.outsourcedRepair?.vendorCost)"></span>
                                <span class="text-[10px] font-semibold text-slate-500" x-text="ticket?.outsourcedRepair?.expectedReturnDate ? ('ETA ' + formatDate(ticket?.outsourcedRepair?.expectedReturnDate)) : 'No ETA'"></span>
                            </div>
                            <span x-show="ticket?.outsourcedRepair?.receivedDate" class="text-[10px] text-emerald-600 font-semibold block mt-0.5" x-text="'Received: ' + formatDate(ticket?.outsourcedRepair?.receivedDate)"></span>
                        </div>
                    </div>

                    <!-- Partner Remarks -->
                    <div x-show="ticket?.outsourcedRepair?.notes" class="p-3 bg-slate-50 border border-slate-200/80 rounded-xl text-xs text-slate-700">
                        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 block mb-1">Partner Workshop Remarks</span>
                        <p class="italic leading-relaxed" x-text="ticket?.outsourcedRepair?.notes"></p>
                    </div>
                </div>
            </div>

            <!-- 3. Activity Timeline -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-2xs space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                            <i class="fas fa-timeline"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-900 font-display">Activity & Service Log</h2>
                            <p class="text-[11px] text-slate-400">Audit trail of ticket updates</p>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono text-slate-500 font-bold bg-slate-100 px-2.5 py-1 rounded-lg"
                        x-text="`${ticket?.logs?.length || 0} Events Logged`"></span>
                </div>

                <div class="relative pl-6 space-y-4 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200 text-xs">
                    <template x-for="(log, idx) in ticket?.logs" :key="idx">
                        <div class="relative group">
                            <div class="absolute -left-6 top-1.5 w-2.5 h-2.5 rounded-full border-2 border-white bg-primary-600 shadow-2xs"></div>
                            <div class="bg-slate-50/70 p-3.5 rounded-xl border border-slate-200/70 hover:bg-white hover:shadow-xs transition-all">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
                                    <h4 class="font-bold text-slate-900 text-xs" x-text="log.label"></h4>
                                    <span class="text-[10px] font-mono text-slate-400" x-text="formatDateTime(log.timestamp)"></span>
                                </div>
                                <p x-show="log.note" class="text-[11px] text-slate-500 italic mt-0.5" x-text="log.note"></p>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- Right Column: Customer Dossier & Financial Ledger (4 cols) -->
        <div class="lg:col-span-4 space-y-5">
            
            <!-- Customer Dossier -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-2xs space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-md bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-display">Client Dossier</h3>
                    </div>
                    <a x-show="ticket?.customer?._id" :href="`/contacts?id=${ticket?.customer?._id}`"
                        class="text-[11px] font-bold text-primary-600 hover:text-primary-700 flex items-center gap-1">
                        <span>Profile</span>
                        <i class="fas fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-primary-100 text-primary-700 font-black text-base flex items-center justify-center shadow-2xs shrink-0"
                        x-text="ticket?.customer?.name ? ticket.customer.name.charAt(0).toUpperCase() : 'C'"></div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 font-display" x-text="ticket?.customer?.name || 'Walk-in Client'"></h4>
                        <p class="text-xs font-mono text-slate-500 mt-0.5" x-text="ticket?.customer?.phone || 'No phone'"></p>
                        <p x-show="ticket?.customer?.companyName" class="text-[11px] text-slate-400" x-text="ticket?.customer?.companyName"></p>
                    </div>
                </div>

                <!-- Clean Dual Buttons (WhatsApp & Call) -->
                <div class="pt-2 grid grid-cols-2 gap-2">
                    <button type="button" @click="openWhatsApp()"
                        class="py-2 bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all shadow-2xs active:scale-95">
                        <i class="fab fa-whatsapp text-sm"></i>
                        <span>WhatsApp</span>
                    </button>
                    <a x-show="ticket?.customer?.phone" :href="`tel:${ticket?.customer?.phone}`"
                        class="py-2 bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all shadow-2xs active:scale-95">
                        <i class="fas fa-phone text-xs text-slate-400"></i>
                        <span>Call</span>
                    </a>
                </div>
            </div>

            <!-- Financial Assessment & Billing -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-2xs space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-display">Financial Assessment</h3>
                    </div>
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Accounting Synced</span>
                </div>

                <!-- Charge Box -->
                <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-xl space-y-3">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Service Charge (Estimate)</span>
                        <div class="flex items-baseline gap-1.5 font-mono">
                            <span class="text-slate-400 font-bold text-lg">₹</span>
                            <span class="text-3xl font-extrabold text-slate-900 tracking-tight"
                                x-text="formatCurrency(ticket?.serviceCharge)"></span>
                        </div>
                    </div>

                    <div class="pt-2.5 border-t border-slate-200/70 flex items-center justify-between text-xs">
                        <span class="text-slate-500 font-medium">Ledger Status:</span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold"
                            :class="isSettled ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'">
                            <span class="w-1.5 h-1.5 rounded-full" :class="isSettled ? 'bg-emerald-500' : 'bg-amber-500'"></span>
                            <span x-text="isSettled ? 'Settled in Ledger' : 'Outstanding / Pending'"></span>
                        </span>
                    </div>
                </div>

                <div class="space-y-2 pt-1">
                    <button type="button" @click="settlePayment()"
                        x-show="!isSettled && (ticket?.serviceCharge > 0)"
                        class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-xs transition-all flex items-center justify-center gap-1.5 active:scale-95">
                        <i class="fas fa-check-double text-xs"></i>
                        <span>Confirm Payment</span>
                    </button>

                    <a :href="`/invoices/create?type=Invoice&serviceTicketId=${ticket?._id}&customer=${ticket?.customer?._id || ''}`"
                        class="w-full py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl text-xs font-bold shadow-md shadow-primary-200 transition-all flex items-center justify-center gap-1.5 active:scale-95">
                        <i class="fas fa-file-invoice text-xs"></i>
                        <span>Generate GST Invoice</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Outsourced Repair Modal (Teleported to body to avoid header z-index overlap) -->
    <template x-teleport="body">
        <div x-show="showOutsourceModal" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none;"
            x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs" @click="showOutsourceModal = false"></div>

            <div class="flex min-h-full items-center justify-center p-4">
                <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 space-y-5"
                    @click.stop>
                    <!-- Header -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                                <i class="fas fa-truck-fast"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">Manage 3rd-Party Repair Tracking</h3>
                                <p class="text-[11px] text-slate-400">Record external workshop details & progress</p>
                            </div>
                        </div>
                        <button type="button" @click="showOutsourceModal = false" class="text-slate-400 hover:text-slate-600">
                            <i class="fas fa-xmark text-sm"></i>
                        </button>
                    </div>

                    <!-- Form -->
                    <form @submit.prevent="saveOutsourceTracking()" class="space-y-4 text-xs">
                        <!-- Outsource Enabled Toggle -->
                        <div class="flex items-center justify-between p-3 bg-purple-50/50 border border-purple-200/60 rounded-xl">
                            <div>
                                <span class="font-bold text-slate-900 block">Outsourced to External Shop</span>
                                <span class="text-[11px] text-slate-500">Enable tracking for 3rd-party repair partner</span>
                            </div>
                            <input type="checkbox" x-model="outsourceForm.isOutsourced" class="w-4 h-4 text-purple-600 rounded cursor-pointer">
                        </div>

                        <!-- 1. Custody Location Selection -->
                        <div class="space-y-1.5">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Custody ("Where is it?")</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button" @click="outsourceForm.custodyLocation = 'In-House'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.custodyLocation === 'In-House' ? 'bg-slate-900 text-white border-slate-900 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Still in Shop
                                </button>
                                <button type="button" @click="outsourceForm.custodyLocation = 'At Partner Shop'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.custodyLocation === 'At Partner Shop' ? 'bg-purple-600 text-white border-purple-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Still There
                                </button>
                                <button type="button" @click="outsourceForm.custodyLocation = 'Received Back'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.custodyLocation === 'Received Back' ? 'bg-emerald-600 text-white border-emerald-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Given Here
                                </button>
                            </div>
                        </div>

                        <!-- 2. Diagnostic Progress & Outcome Selection -->
                        <div class="space-y-1.5">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Diagnostic Progress & Outcome</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <button type="button" @click="outsourceForm.repairOutcome = 'In Progress'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.repairOutcome === 'In Progress' ? 'bg-blue-600 text-white border-blue-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    In Diagnostic
                                </button>
                                <button type="button" @click="outsourceForm.repairOutcome = 'Repaired'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.repairOutcome === 'Repaired' ? 'bg-emerald-600 text-white border-emerald-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Repaired
                                </button>
                                <button type="button" @click="outsourceForm.repairOutcome = 'Not Repaired'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.repairOutcome === 'Not Repaired' ? 'bg-amber-600 text-white border-amber-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Not Repaired
                                </button>
                                <button type="button" @click="outsourceForm.repairOutcome = 'Cant Repair'"
                                    class="py-2 px-1 text-center rounded-lg border text-[11px] font-semibold transition-all"
                                    :class="outsourceForm.repairOutcome === 'Cant Repair' ? 'bg-rose-600 text-white border-rose-600 shadow-xs' : 'bg-slate-50 text-slate-700 border-slate-200'">
                                    Can't Repair
                                </button>
                            </div>
                        </div>

                        <!-- Partner Shop & Contact -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Partner Shop Name</label>
                                <input type="text" x-model="outsourceForm.partnerShopName" placeholder="e.g. Apex Chip Level Lab"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Partner Phone / Contact</label>
                                <input type="text" x-model="outsourceForm.partnerContact" placeholder="e.g. 9876543210"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                        </div>

                        <!-- External Ref & Vendor Cost -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Partner Job / RMA Ref #</label>
                                <input type="text" x-model="outsourceForm.externalJobNumber" placeholder="e.g. APX-9941"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Partner Fee / Cost (₹)</label>
                                <input type="number" min="0" x-model="outsourceForm.vendorCost" placeholder="0"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Date Dispatched</label>
                                <input type="date" x-model="outsourceForm.sentDate"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                            <div class="space-y-1">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Expected Return ETA</label>
                                <input type="date" x-model="outsourceForm.expectedReturnDate"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400">
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="space-y-1">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Partner Diagnostic Remarks</label>
                            <textarea x-model="outsourceForm.notes" rows="2" placeholder="e.g. Sent for BGA reballing. Partner waiting for stencil..."
                                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-purple-400"></textarea>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                            <button type="button" @click="showOutsourceModal = false"
                                class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                                Cancel
                            </button>
                            <button type="submit" :disabled="savingOutsource"
                                class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-purple-200 flex items-center gap-1.5 active:scale-95 disabled:opacity-50">
                                <i :class="savingOutsource ? 'fas fa-spinner fa-spin' : 'fas fa-check'" class="text-[10px]"></i>
                                <span x-text="savingOutsource ? 'Saving...' : 'Save Tracking'"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>
</div>