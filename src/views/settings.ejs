<script src="/js/pages/settings.js"></script>

<div x-data="settingsData" x-init="init()" class="space-y-4 animate__animated animate__fadeIn pb-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-200/80">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Shop Settings</h1>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-primary-50 text-primary-700 border border-primary-200/60">
                    Configuration Registry
                </span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">Manage store identity, staff access, neural AI provider, QR links, and GST invoicing parameters</p>
        </div>
        <div class="flex items-center gap-2">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-white border border-slate-200/80 rounded-lg text-xs shadow-xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-slate-600 font-medium">Registry Active</span>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
        <!-- Sidebar Navigation -->
        <div class="lg:col-span-3 space-y-3">
            <div class="bg-white border border-slate-200/80 rounded-xl p-1.5 shadow-xs space-y-0.5">
                <button type="button" @click="activeTab = 'general'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'general' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fas fa-store text-xs w-4 text-center" :class="activeTab === 'general' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>Shop Identity</span>
                    </div>
                    <i class="fas fa-chevron-right text-[10px]" :class="activeTab === 'general' ? 'text-primary-500 opacity-100' : 'opacity-0'"></i>
                </button>

                <button type="button" @click="activeTab = 'billing'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'billing' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fas fa-file-invoice-dollar text-xs w-4 text-center" :class="activeTab === 'billing' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>GST & Invoicing</span>
                    </div>
                    <i class="fas fa-chevron-right text-[10px]" :class="activeTab === 'billing' ? 'text-primary-500 opacity-100' : 'opacity-0'"></i>
                </button>

                <button type="button" @click="activeTab = 'ai'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'ai' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fas fa-robot text-xs w-4 text-center" :class="activeTab === 'ai' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>AI Protocol</span>
                    </div>
                    <span x-show="settings.aiEnabled" class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">Active</span>
                </button>

                <button type="button" @click="activeTab = 'reviews'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'reviews' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fas fa-qrcode text-xs w-4 text-center" :class="activeTab === 'reviews' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>Review & QR Hub</span>
                    </div>
                    <i class="fas fa-chevron-right text-[10px]" :class="activeTab === 'reviews' ? 'text-primary-500 opacity-100' : 'opacity-0'"></i>
                </button>

                <button type="button" @click="activeTab = 'whatsapp-agent'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'whatsapp-agent' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fab fa-whatsapp text-xs w-4 text-center" :class="activeTab === 'whatsapp-agent' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>WhatsApp Agent</span>
                    </div>
                    <span x-show="settings.whatsappAgentEnabled" class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">Active</span>
                </button>

                <button type="button" @click="activeTab = 'users'"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors"
                    :class="activeTab === 'users' ? 'bg-primary-50 text-primary-700 font-semibold border border-primary-200/60 shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 border border-transparent font-medium'">
                    <div class="flex items-center gap-2.5 truncate">
                        <i class="fas fa-users-cog text-xs w-4 text-center" :class="activeTab === 'users' ? 'text-primary-600' : 'text-slate-400'"></i>
                        <span>Team Ledger</span>
                    </div>
                    <i class="fas fa-chevron-right text-[10px]" :class="activeTab === 'users' ? 'text-primary-500 opacity-100' : 'opacity-0'"></i>
                </button>
            </div>

            <!-- Shop Instance Info Card -->
            <div class="bg-white border border-slate-200/80 rounded-xl p-3 shadow-xs space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Shop Profile</span>
                    <span class="w-2.5 h-2.5 rounded-full border border-white shadow-xs" :style="`background-color: ${settings.themeColor || '#7c3aed'}`"></span>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-900 truncate" x-text="settings.shopName || 'Store Identity'"></p>
                    <p class="text-[11px] font-mono text-slate-400 truncate" x-text="settings.email || 'support@yourshop.com'"></p>
                </div>
                <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                    <span class="text-slate-500">GST Registration</span>
                    <span class="font-mono font-medium" :class="settings.gstin ? 'text-emerald-700 font-semibold' : 'text-slate-400'" x-text="settings.gstin ? 'Configured' : 'Unregistered'"></span>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="lg:col-span-9 space-y-4">
            <!-- 1. GENERAL / SHOP IDENTITY -->
            <div x-show="activeTab === 'general'" x-cloak class="space-y-4">
                <div class="bg-white border border-slate-200/80 rounded-xl shadow-xs overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50/70 border-b border-slate-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-xs">
                                <i class="fas fa-store"></i>
                            </div>
                            <div>
                                <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Shop Identity & Profile</h2>
                                <p class="text-[11px] text-slate-500">Public store metadata, brand accent color, and premises address</p>
                            </div>
                        </div>
                        <button type="submit" form="general-form" :disabled="saving"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 active:scale-[0.98] transition-all shadow-xs disabled:opacity-50">
                            <i :class="saving ? 'fas fa-spinner fa-spin' : 'fas fa-save'" class="text-[11px]"></i>
                            <span x-text="saving ? 'Saving...' : 'Save Changes'"></span>
                        </button>
                    </div>

                    <form id="general-form" @submit.prevent="saveSettings()" class="p-4 space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Shop Name -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Official Shop Name <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" x-model="settings.shopName" required placeholder="e.g. Astr Tech & Repairs"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                            </div>

                            <!-- Primary Brand Color -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Primary Brand Color
                                </label>
                                <div class="flex items-center gap-2">
                                    <div class="relative w-9 h-8 rounded-lg overflow-hidden border border-slate-200 shrink-0 bg-slate-50">
                                        <input type="color" x-model="settings.themeColor"
                                            class="absolute -inset-2 w-14 h-14 cursor-pointer border-none bg-transparent">
                                    </div>
                                    <input type="text" x-model="settings.themeColor"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono font-medium uppercase text-slate-900 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                            </div>

                            <!-- Support Phone -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Support Phone
                                </label>
                                <input type="tel" x-model="settings.phone" placeholder="e.g. +91 98765 43210"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                            </div>

                            <!-- Support Email -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Support Email
                                </label>
                                <input type="email" x-model="settings.email" placeholder="e.g. support@yourshop.com"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                            </div>

                            <!-- Instagram Handle -->
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider">
                                        Instagram Username
                                    </label>
                                    <a :href="getInstagramRedirectLink()" target="_blank" x-show="settings.instagramUsername"
                                        class="text-[10px] text-pink-600 font-semibold hover:underline inline-flex items-center gap-1">
                                        <span>Test /instagram</span>
                                        <i class="fas fa-external-link-alt text-[8px]"></i>
                                    </a>
                                </div>
                                <div class="flex rounded-lg shadow-2xs">
                                    <span class="inline-flex items-center px-2.5 rounded-l-lg border border-r-0 border-slate-200 bg-slate-100 text-slate-500 text-xs font-mono font-bold select-none">@</span>
                                    <input type="text" x-model="settings.instagramUsername" placeholder="yourshopname"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-r-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                            </div>

                            <!-- Google Review Link -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Google Review / Rating Link
                                </label>
                                <input type="url" x-model="settings.reviewUrl" placeholder="https://g.page/r/your-link/review"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                            </div>

                            <!-- Shop Address -->
                            <div class="sm:col-span-2">
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Shop Address (Printed on Invoices & Receipts)
                                </label>
                                <textarea x-model="settings.address" rows="2" placeholder="Full address of your storefront or workshop..."
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all resize-none"></textarea>
                            </div>
                        </div>
                    </form>

                    <div class="px-4 py-3 bg-slate-50/70 border-t border-slate-200/80 flex items-center justify-between text-xs">
                        <span class="text-slate-400 text-[11px]">Branding updates synchronize across invoices, receipts, and public review links.</span>
                        <button type="submit" form="general-form" :disabled="saving"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 active:scale-[0.98] transition-all shadow-xs disabled:opacity-50">
                            <i :class="saving ? 'fas fa-spinner fa-spin' : 'fas fa-save'" class="text-[11px]"></i>
                            <span x-text="saving ? 'Saving...' : 'Save Changes'"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. GST & INVOICING -->
            <div x-show="activeTab === 'billing'" x-cloak class="space-y-4">
                <div class="bg-white border border-slate-200/80 rounded-xl shadow-xs overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50/70 border-b border-slate-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-xs">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                            <div>
                                <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">GST & Invoicing Protocol</h2>
                                <p class="text-[11px] text-slate-500">Tax identification numbers, voucher sequences, bank settlement details, and terms</p>
                            </div>
                        </div>
                        <button type="submit" form="billing-form" :disabled="saving"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 active:scale-[0.98] transition-all shadow-xs disabled:opacity-50">
                            <i :class="saving ? 'fas fa-spinner fa-spin' : 'fas fa-save'" class="text-[11px]"></i>
                            <span x-text="saving ? 'Saving...' : 'Save Invoicing Settings'"></span>
                        </button>
                    </div>

                    <form id="billing-form" @submit.prevent="saveSettings()" class="p-4 space-y-5">
                        <!-- GST Parameters -->
                        <div class="space-y-3">
                            <div class="flex items-center gap-1.5 pb-1 border-b border-slate-100">
                                <i class="fas fa-landmark text-primary-600 text-xs"></i>
                                <span class="text-xs font-bold text-slate-900 uppercase tracking-wider">GST & Tax Parameters</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                                <div class="sm:col-span-2">
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        GSTIN (15 Digits)
                                    </label>
                                    <input type="text" x-model="settings.gstin" placeholder="e.g. 27AAAAA0000A1Z5" maxlength="15"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono uppercase text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        State Name
                                    </label>
                                    <input type="text" x-model="settings.state" placeholder="e.g. Maharashtra"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        State Code
                                    </label>
                                    <input type="text" x-model="settings.stateCode" placeholder="e.g. 27" maxlength="2"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div class="sm:col-span-4">
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Default GST Rate (%)
                                    </label>
                                    <select x-model="settings.defaultGstRate"
                                        class="w-full sm:w-72 px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                        <option value="0">0% (Nil / Exempted)</option>
                                        <option value="5">5% (Essential Goods)</option>
                                        <option value="12">12% (Standard Low)</option>
                                        <option value="18">18% (Services & Electronics)</option>
                                        <option value="28">28% (Luxury / High)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Sequences & Numbering -->
                        <div class="space-y-3 pt-3 border-t border-slate-100">
                            <div class="flex items-center gap-1.5 pb-1 border-b border-slate-100">
                                <i class="fas fa-hashtag text-primary-600 text-xs"></i>
                                <span class="text-xs font-bold text-slate-900 uppercase tracking-wider">Document Sequence Counters</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Invoice Prefix
                                    </label>
                                    <input type="text" x-model="settings.invoicePrefix" placeholder="INV-"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Next Invoice #
                                    </label>
                                    <input type="number" x-model.number="settings.invoiceNextNumber" min="1"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono tabular-nums text-slate-900 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Quotation Prefix
                                    </label>
                                    <input type="text" x-model="settings.quotationPrefix" placeholder="QTN-"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Next Quotation #
                                    </label>
                                    <input type="number" x-model.number="settings.quotationNextNumber" min="1"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono tabular-nums text-slate-900 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                            </div>
                        </div>

                        <!-- Banking Information -->
                        <div class="space-y-3 pt-3 border-t border-slate-100">
                            <div class="flex items-center gap-1.5 pb-1 border-b border-slate-100">
                                <i class="fas fa-university text-primary-600 text-xs"></i>
                                <span class="text-xs font-bold text-slate-900 uppercase tracking-wider">Settlement & Bank Details</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Bank Name
                                    </label>
                                    <input type="text" x-model="settings.bankName" placeholder="e.g. HDFC Bank"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Account Number
                                    </label>
                                    <input type="text" x-model="settings.bankAccountNumber" placeholder="e.g. 50200012345678"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        IFSC Code
                                    </label>
                                    <input type="text" x-model="settings.bankIfsc" placeholder="e.g. HDFC0001234" uppercase
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono uppercase text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                        Branch Name
                                    </label>
                                    <input type="text" x-model="settings.bankBranch" placeholder="e.g. Main Branch"
