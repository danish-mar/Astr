                                <button type="button" @click="downloadQrCode()"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 text-white rounded-lg text-xs font-medium hover:bg-slate-800 transition-colors shadow-xs">
                                    <i class="fas fa-download text-[11px]"></i>
                                    <span>Download PNG</span>
                                </button>
                                <button type="button" @click="printQrCode()"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 transition-colors shadow-xs">
                                    <i class="fas fa-print text-[11px]"></i>
                                    <span>Print Standee</span>
                                </button>
                                <button type="button" @click="copyReviewLink()"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 rounded-lg text-xs font-medium hover:bg-slate-50 transition-colors shadow-xs">
                                    <i class="fas fa-link text-[11px] text-slate-400"></i>
                                    <span>Copy URL</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. WHATSAPP AGENT -->
            <div x-show="activeTab === 'whatsapp-agent'" x-cloak class="space-y-4">
                <div class="bg-white border border-slate-200/80 rounded-xl shadow-xs overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50/70 border-b border-slate-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                                <i class="fab fa-whatsapp"></i>
                            </div>
                            <div>
                                <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">WhatsApp Autonomous Agent</h2>
                                <p class="text-[11px] text-slate-500">Auto-quote customers, query vendor availability, and notify boss on confirmed deals</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/whatsapp/link" target="_blank"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition-all shadow-xs">
                                <i class="fab fa-whatsapp text-emerald-600"></i>
                                <span>WhatsApp Session</span>
                            </a>
                            <button type="submit" form="whatsapp-agent-form" :disabled="saving"
                                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 active:scale-[0.98] transition-all shadow-xs disabled:opacity-50">
                                <i :class="saving ? 'fas fa-spinner fa-spin' : 'fas fa-save'" class="text-[11px]"></i>
                                <span x-text="saving ? 'Saving...' : 'Save Changes'"></span>
                            </button>
                        </div>
                    </div>

                    <form id="whatsapp-agent-form" @submit.prevent="saveSettings()" class="p-4 space-y-4">
                        <!-- Agent Toggle Card -->
                        <div class="p-3.5 bg-slate-50/70 border border-slate-200/80 rounded-xl flex items-center justify-between">
                            <div class="space-y-0.5">
                                <span class="text-xs font-bold text-slate-900">Activate Autonomous WhatsApp Agent</span>
                                <p class="text-[11px] text-slate-500">
                                    When linked, the agent continuously replies to customer inquiries, queries suppliers for wholesale rates, and seals deals.
                                </p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" x-model="settings.whatsappAgentEnabled" class="sr-only peer">
                                <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
                            </label>
                        </div>

                        <!-- Configuration Fields -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Boss WhatsApp Phone -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Boss WhatsApp Number <span class="text-rose-500">*</span>
                                </label>
                                <input type="tel" x-model="settings.bossPhone" placeholder="e.g. 9876543210"
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                <p class="text-[10px] text-slate-400 mt-1">
                                    Receives immediate deal summaries, gross profit calculations, and actionable AI suggestions whenever a customer confirms a purchase.
                                </p>
                            </div>

                            <!-- Default Margin % -->
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-600 uppercase tracking-wider mb-1">
                                    Default Profit Margin (%) <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <input type="number" min="0" max="200" step="1" x-model.number="settings.defaultMarginPercent" required placeholder="20"
                                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-primary-500 focus:ring-1 focus:ring-primary-500/20 outline-none transition-all">
                                    <span class="absolute right-3 top-2 text-xs font-bold text-slate-400">%</span>
                                </div>
                                <p class="text-[10px] text-slate-400 mt-1">
                                    Applied on supplier quotes when a category-specific margin is not defined. (Categories can have custom margins).
                                </p>
                            </div>
                        </div>

                        <!-- Agent Workflow Diagram / Infographic -->
                        <div class="mt-4 pt-4 border-t border-slate-100">
                            <h3 class="text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-2">Automated Protocol Lifecycle</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <div class="p-3 bg-slate-50 rounded-lg border border-slate-200/60 space-y-1">
                                    <div class="flex items-center gap-1.5 text-xs font-bold text-slate-900">
                                        <span class="w-5 h-5 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center text-[10px]">1</span>
                                        <span>Customer Asks</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">
                                        Customer asks for a product, price, or part. If not in store stock, agent pings registered Vendors for rate and availability.
                                    </p>
                                </div>
                                <div class="p-3 bg-slate-50 rounded-lg border border-slate-200/60 space-y-1">
                                    <div class="flex items-center gap-1.5 text-xs font-bold text-slate-900">
                                        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px]">2</span>
                                        <span>Vendor Quotes & Margin</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">
                                        Vendor replies with wholesale rate. Agent parses cost, adds configured category profit margin, and sends rate to customer.
                                    </p>
                                </div>
                                <div class="p-3 bg-slate-50 rounded-lg border border-slate-200/60 space-y-1">
                                    <div class="flex items-center gap-1.5 text-xs font-bold text-slate-900">
                                        <span class="w-5 h-5 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-[10px]">3</span>
                                        <span>Deal Closed & Boss Alert</span>
                                    </div>
                                    <p class="text-[11px] text-slate-500">
                                        Customer confirms with "YES" or "Deal". Agent sends confirmation and immediately alerts the Boss with financial summary & AI suggestions.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 6. TEAM LEDGER -->
            <div x-show="activeTab === 'users'" x-cloak class="space-y-4">
                <div class="bg-white border border-slate-200/80 rounded-xl shadow-xs overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50/70 border-b border-slate-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-xs">
                                <i class="fas fa-users-cog"></i>
                            </div>
                            <div>
                                <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Team Ledger & Staff Permissions</h2>
                                <p class="text-[11px] text-slate-500">Access control, credentials management, and role-based permissions</p>
                            </div>
                        </div>
                        <a href="/team"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-600 text-white rounded-lg text-xs font-medium hover:bg-primary-700 active:scale-[0.98] transition-all shadow-xs">
                            <span>Open Team Workspace</span>
                            <i class="fas fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>

                    <div class="p-8 text-center flex flex-col items-center justify-center space-y-3">
                        <div class="w-12 h-12 rounded-xl bg-primary-50 border border-primary-200/60 flex items-center justify-center text-primary-600">
                            <i class="fas fa-shield-halved text-lg"></i>
                        </div>
                        <div class="space-y-1 max-w-md">
                            <h3 class="text-sm font-bold text-slate-900">Dedicated Team Management Portal</h3>
                            <p class="text-xs text-slate-500">
                                Staff user accounts, role permissions (Technician, Cashier, Manager, Administrator), and secure login tokens are managed in the specialized Team Ledger workspace.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="/team"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-lg text-xs font-medium hover:bg-slate-800 transition-colors shadow-xs">
                                <i class="fas fa-users text-xs text-slate-400"></i>
                                <span>Go to Team Workspace</span>
                                <i class="fas fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>